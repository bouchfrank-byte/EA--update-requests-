+-- =====================================================================================
+-- Easy Assign - Unified Backup / Share (Step 1)
+-- =====================================================================================
+-- Foundation for the multi-session Backup/Share feature (see spec). This block adds a
+-- header-tagged, versioned, checksummed, LibDeflate-compressed round-trippable string
+-- format plus scope builders, import/apply, and a copy-paste panel.
+--
+-- IMPORTANT (Lua 5.1 slot budget): the main chunk is already near the 200 top-level
+-- local limit, so EVERYTHING here lives on the global table EasyAssignBackupShare and
+-- reads existing chunk-locals (mainFrame, state, raids, DecodeJson, SetPanelBackdrop,
+-- backdropTemplate, GetSelectedRaid, GetSelectedBoss, GetRaidIndexById, ...). No new
+-- top-level locals are declared.
+--
+-- Serialization is intentionally NOT reusing the assignment-profile transfer popup
+-- frames (to avoid regressing that already-tested flow) but DOES reuse the same
+-- serialization primitives: EasyAssignEncodeJsonValue / DecodeJson / LibDeflate.
+-- =====================================================================================
+
+EasyAssignBackupShare = EasyAssignBackupShare or {}
+
+-- Wire format constants ---------------------------------------------------------------
+-- Fixed-width header keeps parsing delimiter-free:
+--   [1-4]  magic  = "EAB1"  (Easy Assign Backup, wire format v1)
+--   [5]    flags  = "C" (LibDeflate compressed + EncodeForPrint) or "P" (plain JSON)
+--   [6-13] cksum  = 8 hex chars, Adler-32 of the body substring
+--   [14..] body
+EasyAssignBackupShare.MAGIC = "EAB1"
+EasyAssignBackupShare.HEADER_LEN = 13          -- 4 magic + 1 flags + 8 checksum
+EasyAssignBackupShare.FLAG_COMPRESSED = "C"
+EasyAssignBackupShare.FLAG_PLAIN = "P"
+EasyAssignBackupShare.PAYLOAD_FMT = 1          -- inner schema version (data structure)
+EasyAssignBackupShare.ADDON_TAG = "EasyAssign"
+
+-- Adler-32 checksum (pure Lua 5.1). Deterministic, cheap, catches truncation/corruption
+-- and body-format changes. Computed over the encoded body exactly as it appears in the
+-- string so an importer can recompute it from the pasted body alone.
+function EasyAssignBackupShare.Adler32(text)
+    if type(text) ~= "string" then
+        return 0
+    end
+
+    local MOD = 65521
+    local a = 1
+    local b = 0
+    local length = #text
+
+    -- Process in blocks to keep a/b well under 2^31 before the modulo (NMAX = 5552).
+    local index = 1
+    while index <= length do
+        local blockEnd = index + 5551
+        if blockEnd > length then
+            blockEnd = length
+        end
+
+        for i = index, blockEnd do
+            a = a + string.byte(text, i)
+            b = b + a
+        end
+
+        a = a % MOD
+        b = b % MOD
+        index = blockEnd + 1
+    end
+
+    return b * 65536 + a
+end
+
+function EasyAssignBackupShare.ChecksumHex(text)
+    return string.format("%08x", EasyAssignBackupShare.Adler32(text))
+end
+
+-- Compress + wire-encode a raw JSON string into a paste-safe body, if LibDeflate is
+-- present. Returns body, flag. Falls back to plain JSON so export never hard-fails.
+function EasyAssignBackupShare.EncodeBody(rawText)
+    if type(rawText) ~= "string" then
+        rawText = ""
+    end
+
+    local lib = type(EasyAssignGetLibDeflate) == "function" and EasyAssignGetLibDeflate() or nil
+
+    if type(lib) == "table" then
+        local ok, encoded = pcall(function()
+            return lib:EncodeForPrint(lib:CompressDeflate(rawText))
+        end)
+
+        if ok and type(encoded) == "string" and encoded ~= "" then
+            return encoded, EasyAssignBackupShare.FLAG_COMPRESSED
+        end
+    end
+
+    return rawText, EasyAssignBackupShare.FLAG_PLAIN
+end
+
+-- Reverse of EncodeBody. Returns rawText or (nil, error).
+function EasyAssignBackupShare.DecodeBody(body, flag)
+    if type(body) ~= "string" then
+        return nil, "Missing import body."
+    end
+
+    if flag == EasyAssignBackupShare.FLAG_PLAIN then
+        return body
+    end
+
+    if flag == EasyAssignBackupShare.FLAG_COMPRESSED then
+        local lib = type(EasyAssignGetLibDeflate) == "function" and EasyAssignGetLibDeflate() or nil
+
+        if type(lib) ~= "table" then
+            return nil, "This string is compressed but LibDeflate is not loaded. Enable it and reload."
+        end
+
+        local ok, decoded = pcall(function()
+            return lib:DecompressDeflate(lib:DecodeForPrint(body))
+        end)
+
+        if ok and type(decoded) == "string" and decoded ~= "" then
+            return decoded
+        end
+
+        return nil, "Could not decompress the string (corrupted or wrong format)."
+    end
+
+    return nil, "Unknown string encoding."
+end
+
+-- Serialize a payload table -> a full copy-paste string.
+function EasyAssignBackupShare.Encode(payload)
+    if type(payload) ~= "table" then
+        return nil, "Nothing to export."
+    end
+
+    if type(EasyAssignEncodeJsonValue) ~= "function" then
+        return nil, "JSON encoder unavailable."
+    end
+
+    local rawText = EasyAssignEncodeJsonValue(payload)
+
+    if type(rawText) ~= "string" or rawText == "" then
+        return nil, "Could not serialize the export."
+    end
+
+    local body, flag = EasyAssignBackupShare.EncodeBody(rawText)
+    local checksum = EasyAssignBackupShare.ChecksumHex(body)
+
+    return EasyAssignBackupShare.MAGIC .. flag .. checksum .. body
+end
+
+-- Parse a full copy-paste string -> the raw JSON text and its flag, validating the
+-- magic/version and checksum. Returns rawText, flag or (nil, error).
+function EasyAssignBackupShare.UnwrapString(importText)
+    if type(importText) ~= "string" then
+        return nil, nil, "Paste an Easy Assign backup string first."
+    end
+
+    -- Tolerate stray surrounding whitespace/newlines from pasting.
+    importText = string.gsub(importText, "^%s+", "")
+    importText = string.gsub(importText, "%s+$", "")
+
+    if importText == "" then
+        return nil, nil, "Paste an Easy Assign backup string first."
+    end
+
+    if #importText < EasyAssignBackupShare.HEADER_LEN + 1 then
+        return nil, nil, "This is not an Easy Assign backup string (too short)."
+    end
+
+    local magic = string.sub(importText, 1, 4)
+    if magic ~= EasyAssignBackupShare.MAGIC then
+        return nil, nil, "This is not an Easy Assign backup string (bad header)."
+    end
+
+    local flag = string.sub(importText, 5, 5)
+    if flag ~= EasyAssignBackupShare.FLAG_COMPRESSED and flag ~= EasyAssignBackupShare.FLAG_PLAIN then
+        return nil, nil, "Unsupported Easy Assign backup version."
+    end
+
+    local checksum = string.sub(importText, 6, 13)
+    local body = string.sub(importText, 14)
+
+    if string.lower(EasyAssignBackupShare.ChecksumHex(body)) ~= string.lower(checksum) then
+        return nil, nil, "The string is corrupted or was truncated when copied. Copy it again in full."
+    end
+
+    local rawText, decodeError = EasyAssignBackupShare.DecodeBody(body, flag)
+    if not rawText then
+        return nil, nil, decodeError or "Could not read the string."
+    end
+
+    return rawText, flag
+end
+
+-- =====================================================================================
+-- Chunk B: scope model + payload builders
+-- =====================================================================================
+-- Scope descriptor shape: { kind = <string>, teamName=, raidId=, bossId= }
+-- kinds: "everything" | "team" | "raidAssignments" | "bossAssignments" | "bossMap" | "settings"
+
+-- Portable top-level EasyAssignDB keys included in an "everything" export. Anything not
+-- listed here is intentionally dropped (machine/UI state, transient scratch, sync prefs).
+EasyAssignBackupShare.PORTABLE_DB_KEYS = {
+    "placements",
+    "assignments",
+    "assignmentPresetLiveRaidAssignments",
+    "assignmentProfiles",
+    "activeAssignmentProfileIdsByRaid",
+    "defaultRosterSelections",
+    "presets",
+    "customRoster",
+    "generalRaidAssignments",
+    "generalRaidAssignmentsRaidId",
+    "raidGeneralAssignments",
+    "popupBossOrders",
+    "autoSync",
+    "settings",
+}
+
+-- Settings sub-keys that are machine-specific and excluded from settings/everything
+-- exports (open item #3: exclude window/popup positions and per-client toggles).
+EasyAssignBackupShare.MACHINE_SETTING_KEYS = {
+    myAssignmentsPopupPosition = true,
+    raidLeaderWindowPosition = true,
+    myAssignmentsPopupMinimized = true,
+    raidLeaderWindowMinimized = true,
+}
+
+function EasyAssignBackupShare.GetOwnerName()
+    if type(UnitName) == "function" then
+        local ok, name = pcall(UnitName, "player")
+        if ok and type(name) == "string" and name ~= "" then
+            return name
+        end
+    end
+    return "Unknown"
+end
+
+function EasyAssignBackupShare.FindRaid(raidId)
+    if type(raidId) ~= "string" or raidId == "" then
+        return nil
+    end
+    if type(GetEasyAssignRaidById) == "function" then
+        local raid = GetEasyAssignRaidById(raidId)
+        if type(raid) == "table" then
+            return raid
+        end
+    end
+    -- Fallback: scan the chunk-local raids table directly.
+    if type(raids) == "table" then
+        for _, raid in ipairs(raids) do
+            if type(raid) == "table" and raid.id == raidId then
+                return raid
+            end
+        end
+    end
+    return nil
+end
+
+function EasyAssignBackupShare.FindBossName(raid, bossId)
+    if type(raid) ~= "table" or type(raid.bosses) ~= "table" or type(bossId) ~= "string" then
+        return nil
+    end
+    for _, boss in ipairs(raid.bosses) do
+        if type(boss) == "table" and boss.id == bossId then
+            return boss.name or bossId
+        end
+    end
+    return nil
+end
+
+-- Copy a settings table minus machine-specific keys.
+function EasyAssignBackupShare.FilterSettings(settings)
+    local out = {}
+    if type(settings) ~= "table" then
+        return out
+    end
+    for key, value in pairs(settings) do
+        if not EasyAssignBackupShare.MACHINE_SETTING_KEYS[key] then
+            out[key] = EasyAssignDeepCopyValue(value)
+        end
+    end
+    return out
+end
+
+-- Count assignment entries within a boss/raid assignment store for summary text. The
+-- assignment structures are keyed tables; we count the leaf assignment groups.
+function EasyAssignBackupShare.CountTableEntries(t)
+    local n = 0
+    if type(t) == "table" then
+        for _ in pairs(t) do
+            n = n + 1
+        end
+    end
+    return n
+end
+
+-- Wrap a scope's data into the standard header-tagged payload.
+function EasyAssignBackupShare.MakePayload(scope, name, data, summary)
+    return {
+        fmt = EasyAssignBackupShare.PAYLOAD_FMT,
+        addon = EasyAssignBackupShare.ADDON_TAG,
+        scope = scope,
+        owner = EasyAssignBackupShare.GetOwnerName(),
+        name = name or scope,
+        createdAt = (type(time) == "function" and time()) or 0,
+        summary = type(summary) == "table" and summary or {},
+        data = data,
+    }
+end
+
+-- Build the payload for a scope descriptor. Returns payload, nil or nil, error.
+function EasyAssignBackupShare.BuildPayload(scope)
+    if type(scope) ~= "table" or type(scope.kind) ~= "string" then
+        return nil, "Choose what to export first."
+    end
+
+    if type(EasyAssignDB) ~= "table" then
+        return nil, "Nothing saved to export yet."
+    end
+
+    local kind = scope.kind
+
+    if kind == "everything" then
+        local data = {}
+        for _, key in ipairs(EasyAssignBackupShare.PORTABLE_DB_KEYS) do
+            if EasyAssignDB[key] ~= nil then
+                if key == "settings" then
+                    data.settings = EasyAssignBackupShare.FilterSettings(EasyAssignDB.settings)
+                else
+                    data[key] = EasyAssignDeepCopyValue(EasyAssignDB[key])
+                end
+            end
+        end
+
+        local summary = {
+            teams = EasyAssignBackupShare.CountTableEntries(EasyAssignDB.presets),
+            profiles = EasyAssignBackupShare.CountTableEntries(EasyAssignDB.assignmentProfiles),
+            raidsWithAssignments = EasyAssignBackupShare.CountTableEntries(EasyAssignDB.assignments),
+        }
+
+        return EasyAssignBackupShare.MakePayload("everything", "Everything", data, summary)
+
+    elseif kind == "settings" then
+        local data = EasyAssignBackupShare.FilterSettings(EasyAssignDB.settings)
+
+        if next(data) == nil then
+            return nil, "There are no settings to export yet."
+        end
+
+        return EasyAssignBackupShare.MakePayload("settings", "Settings", data, {
+            settingCount = EasyAssignBackupShare.CountTableEntries(data),
+        })
+
+    elseif kind == "team" then
+        local presets = type(EasyAssignDB.presets) == "table" and EasyAssignDB.presets or {}
+        local teamName = scope.teamName
+        local preset = type(teamName) == "string" and presets[teamName] or nil
+
+        if type(preset) ~= "table" then
+            return nil, "Select a saved raid team to export."
+        end
+
+        local data = EasyAssignDeepCopyValue(preset)
+        data.name = teamName
+
+        return EasyAssignBackupShare.MakePayload("team", teamName, data, {
+            teamName = teamName,
+            raidId = preset.raidId,
+            raidName = preset.raidName,
+        })
+
+    elseif kind == "raidAssignments" then
+        local raid = EasyAssignBackupShare.FindRaid(scope.raidId)
+        if type(raid) ~= "table" then
+            return nil, "Select a raid before exporting its assignments."
+        end
+
+        local assignments = type(GetEasyAssignRaidAssignmentsForRaid) == "function"
+            and GetEasyAssignRaidAssignmentsForRaid(raid.id)
+            or EasyAssignDeepCopyValue(type(EasyAssignDB.assignments) == "table" and EasyAssignDB.assignments[raid.id] or {})
+
+        local general = type(GetEasyAssignGeneralAssignmentsForRaid) == "function"
+            and GetEasyAssignGeneralAssignmentsForRaid(raid.id)
+            or {}
+
+        if EasyAssignBackupShare.CountTableEntries(assignments) == 0
+            and EasyAssignBackupShare.CountTableEntries(general) == 0 then
+            return nil, "This raid has no assignments to export yet."
+        end
+
+        local data = {
+            raidId = raid.id,
+            raidName = raid.name,
+            assignments = assignments,
+            general = general,
+        }
+
+        return EasyAssignBackupShare.MakePayload("raidAssignments", raid.name .. " assignments", data, {
+            raidId = raid.id,
+            raidName = raid.name,
+            bossCount = EasyAssignBackupShare.CountTableEntries(assignments),
+        })
+
+    elseif kind == "bossAssignments" then
+        local raid = EasyAssignBackupShare.FindRaid(scope.raidId)
+        if type(raid) ~= "table" then
+            return nil, "Select a raid and boss before exporting assignments."
+        end
+
+        local bossId = scope.bossId
+        local bossName = EasyAssignBackupShare.FindBossName(raid, bossId)
+        if type(bossId) ~= "string" or bossId == "" or not bossName then
+            return nil, "Select a boss before exporting its assignments."
+        end
+
+        local assignments = type(GetEasyAssignBossAssignmentScopeSnapshot) == "function"
+            and GetEasyAssignBossAssignmentScopeSnapshot(raid.id, bossId)
+            or {}
+
+        if EasyAssignBackupShare.CountTableEntries(assignments) == 0 then
+            return nil, string.format("%s has no assignments to export yet.", bossName)
+        end
+
+        local data = {
+            raidId = raid.id,
+            raidName = raid.name,
+            bossId = bossId,
+            bossName = bossName,
+            assignments = assignments,
+        }
+
+        return EasyAssignBackupShare.MakePayload("bossAssignments",
+            string.format("%s - %s", raid.name, bossName), data, {
+                raidId = raid.id,
+                raidName = raid.name,
+                bossId = bossId,
+                bossName = bossName,
+            })
+
+    elseif kind == "bossMap" then
+        local raid = EasyAssignBackupShare.FindRaid(scope.raidId)
+        if type(raid) ~= "table" then
+            return nil, "Select a raid and boss before exporting a boss map."
+        end
+
+        local bossId = scope.bossId
+        local bossName = EasyAssignBackupShare.FindBossName(raid, bossId)
+        if type(bossId) ~= "string" or bossId == "" or not bossName then
+            return nil, "Select a boss before exporting its map."
+        end
+
+        local raidStore = type(EasyAssignDB.placements) == "table" and EasyAssignDB.placements[raid.id] or nil
+        local bossStore = type(raidStore) == "table" and raidStore[bossId] or nil
+
+        if type(bossStore) ~= "table" or next(bossStore) == nil then
+            return nil, string.format("%s has no saved map to export yet.", bossName)
+        end
+
+        local data = {
+            raidId = raid.id,
+            raidName = raid.name,
+            bossId = bossId,
+            bossName = bossName,
+            placements = EasyAssignDeepCopyValue(bossStore),
+        }
+
+        return EasyAssignBackupShare.MakePayload("bossMap",
+            string.format("%s - %s map", raid.name, bossName), data, {
+                raidId = raid.id,
+                raidName = raid.name,
+                bossId = bossId,
+                bossName = bossName,
+            })
+    end
+
+    return nil, "Unknown export scope."
+end
+
+-- =====================================================================================
+-- Chunk C: import decode -> self-identify -> apply
+-- =====================================================================================
+
+EasyAssignBackupShare.SCOPE_LABELS = {
+    everything = "Everything (full setup)",
+    team = "saved raid team",
+    raidAssignments = "raid assignments",
+    bossAssignments = "boss assignments",
+    bossMap = "boss map",
+    settings = "settings",
+}
+
+-- Decode a pasted string into a validated payload table, or (nil, error).
+function EasyAssignBackupShare.Decode(importText)
+    local rawText, _, unwrapError = EasyAssignBackupShare.UnwrapString(importText)
+    if not rawText then
+        return nil, unwrapError
+    end
+
+    if type(DecodeJson) ~= "function" then
+        return nil, "JSON decoder unavailable."
+    end
+
+    local payload, jsonError = DecodeJson(rawText)
+    if not payload then
+        return nil, jsonError or "Could not read the backup data."
+    end
+
+    if type(payload) ~= "table" then
+        return nil, "Backup data must be an object."
+    end
+
+    if payload.addon ~= nil and payload.addon ~= EasyAssignBackupShare.ADDON_TAG then
+        return nil, "This backup was not made by Easy Assign."
+    end
+
+    if type(payload.fmt) ~= "number" or payload.fmt > EasyAssignBackupShare.PAYLOAD_FMT then
+        return nil, "This backup was made by a newer Easy Assign. Update the addon and try again."
+    end
+
+    if type(payload.scope) ~= "string" or not EasyAssignBackupShare.SCOPE_LABELS[payload.scope] then
+        return nil, "This is not a supported Easy Assign backup scope."
+    end
+
+    if type(payload.data) ~= "table" then
+        return nil, "This backup is missing its data."
+    end
+
+    -- Per-scope structural validation.
+    local scope = payload.scope
+    local data = payload.data
+
+    if scope == "everything" then
+        if next(data) == nil then
+            return nil, "This full-setup backup is empty."
+        end
+    elseif scope == "team" then
+        if type(data.name) ~= "string" or data.name == "" then
+            data.name = type(payload.name) == "string" and payload.name or "Imported Team"
+        end
+    elseif scope == "raidAssignments" then
+        if type(data.raidId) ~= "string" or data.raidId == "" then
+            return nil, "This assignment backup is missing its raid."
+        end
+        if type(data.assignments) ~= "table" then
+            data.assignments = {}
+        end
+        if type(data.general) ~= "table" then
+            data.general = {}
+        end
+    elseif scope == "bossAssignments" then
+        if type(data.raidId) ~= "string" or data.raidId == "" or type(data.bossId) ~= "string" or data.bossId == "" then
+            return nil, "This assignment backup is missing its raid or boss."
+        end
+        if type(data.assignments) ~= "table" then
+            data.assignments = {}
+        end
+    elseif scope == "bossMap" then
+        if type(data.raidId) ~= "string" or data.raidId == "" or type(data.bossId) ~= "string" or data.bossId == "" then
+            return nil, "This map backup is missing its raid or boss."
+        end
+        if type(data.placements) ~= "table" then
+            return nil, "This map backup has no placements."
+        end
+    elseif scope == "settings" then
+        -- data is the settings map itself; nothing further required.
+    end
+
+    return payload
+end
+
+-- Human-readable self-identification for the confirm banner.
+-- Returns { title, detail } derived from the payload's own header fields.
+function EasyAssignBackupShare.Describe(payload)
+    if type(payload) ~= "table" then
+        return { title = "Unknown backup", detail = "" }
+    end
+
+    local scope = payload.scope or "unknown"
+    local owner = type(payload.owner) == "string" and payload.owner ~= "" and payload.owner or nil
+    local summary = type(payload.summary) == "table" and payload.summary or {}
+    local from = owner and (" from " .. owner) or ""
+    local title, detail
+
+    if scope == "everything" then
+        title = "Full setup" .. from
+        detail = string.format("%d saved team(s), %d assignment profile(s), %d raid(s) with assignments.",
+            tonumber(summary.teams) or 0, tonumber(summary.profiles) or 0, tonumber(summary.raidsWithAssignments) or 0)
+    elseif scope == "team" then
+        title = string.format('Saved raid team "%s"%s', payload.name or "Imported Team", from)
+        detail = summary.raidName and ("Built for " .. summary.raidName .. ".") or ""
+    elseif scope == "raidAssignments" then
+        title = string.format("%s assignments%s", summary.raidName or payload.name or "Raid", from)
+        detail = string.format("%d boss section(s).", tonumber(summary.bossCount) or 0)
+    elseif scope == "bossAssignments" then
+        title = string.format("%s assignments%s", summary.bossName or payload.name or "Boss", from)
+        detail = summary.raidName and (summary.raidName .. ".") or ""
+    elseif scope == "bossMap" then
+        title = string.format("%s map%s", summary.bossName or payload.name or "Boss", from)
+        detail = summary.raidName and (summary.raidName .. ".") or ""
+    elseif scope == "settings" then
+        title = "Settings" .. from
+        detail = string.format("%d setting(s).", tonumber(summary.settingCount) or 0)
+    else
+        title = "Easy Assign backup" .. from
+        detail = ""
+    end
+
+    return { title = title, detail = detail }
+end
+
+-- Build a non-colliding, name-suffixed key in `store` for import-as-copy.
+function EasyAssignBackupShare.BuildUniqueKeyName(store, baseName)
+    local trimmed = type(EasyAssignAssignmentProfileImportExport) == "table"
+        and type(EasyAssignAssignmentProfileImportExport.TrimName) == "function"
+        and EasyAssignAssignmentProfileImportExport.TrimName(baseName, "Imported")
+        or (type(baseName) == "string" and baseName ~= "" and baseName or "Imported")
+
+    if type(store) ~= "table" then
+        return trimmed .. " (imported)"
+    end
+
+    local candidate = trimmed .. " (imported)"
+    if store[candidate] == nil then
+        return candidate
+    end
+
+    local index = 2
+    while store[trimmed .. " (imported " .. index .. ")"] ~= nil do
+        index = index + 1
+    end
+
+    return trimmed .. " (imported " .. index .. ")"
+end
+
+-- Refresh visible UI after a successful import. All calls are guarded/optional so the
+-- import itself never fails on a missing refresh hook.
+function EasyAssignBackupShare.RefreshAfterImport(payload)
+    local scope = type(payload) == "table" and payload.scope or nil
+
+    if (scope == "team" or scope == "everything") and type(UpdatePresetsPage) == "function" then
+        pcall(UpdatePresetsPage)
+    end
+
+    if type(EasyAssignQueueUiRefresh) == "function" then
+        pcall(EasyAssignQueueUiRefresh, "assignments", "backupImport")
+        pcall(EasyAssignQueueUiRefresh, "defaultRosterPanel", "backupImport")
+        pcall(EasyAssignQueueUiRefresh, "myAssignmentsPage", "backupImport")
+    end
+end
+
+-- Apply a validated payload. mode = "copy" (default, never clobbers) | "overwrite".
+-- Returns success(boolean), message(string).
+function EasyAssignBackupShare.Apply(payload, mode)
+    if type(payload) ~= "table" then
+        return false, "Nothing to import."
+    end
+
+    mode = (mode == "overwrite") and "overwrite" or "copy"
+
+    if type(EasyAssignDB) ~= "table" then
+        return false, "Easy Assign is not ready yet."
+    end
+
+    local scope = payload.scope
+    local data = payload.data
+    local ok, message
+
+    if scope == "team" then
+        ok, message = EasyAssignBackupShare.ApplyTeam(payload, data, mode)
+    elseif scope == "raidAssignments" then
+        ok, message = EasyAssignBackupShare.ApplyRaidAssignments(payload, data, mode)
+    elseif scope == "bossAssignments" then
+        ok, message = EasyAssignBackupShare.ApplyBossAssignments(payload, data, mode)
+    elseif scope == "bossMap" then
+        ok, message = EasyAssignBackupShare.ApplyBossMap(payload, data, mode)
+    elseif scope == "settings" then
+        ok, message = EasyAssignBackupShare.ApplySettings(payload, data, mode)
+    elseif scope == "everything" then
+        ok, message = EasyAssignBackupShare.ApplyEverything(payload, data, mode)
+    else
+        return false, "Unknown import scope."
+    end
+
+    if ok then
+        EasyAssignBackupShare.RefreshAfterImport(payload)
+    end
+
+    return ok, message
+end
+
+-- Team: copy = new suffixed preset; overwrite = replace by name.
+function EasyAssignBackupShare.ApplyTeam(payload, data, mode)
+    local store = type(GetEasyAssignPresetStore) == "function" and GetEasyAssignPresetStore() or nil
+    if type(store) ~= "table" then
+        if type(EasyAssignDB.presets) ~= "table" then
+            EasyAssignDB.presets = {}
+        end
+        store = EasyAssignDB.presets
+    end
+
+    local baseName = type(data.name) == "string" and data.name ~= "" and data.name or (payload.name or "Imported Team")
+    local preset = EasyAssignDeepCopyValue(data)
+    local targetName
+
+    if mode == "overwrite" then
+        targetName = baseName
+    else
+        targetName = EasyAssignBackupShare.BuildUniqueKeyName(store, baseName)
+    end
+
+    preset.name = targetName
+    preset.isActive = nil
+    preset.isDefault = nil
+    store[targetName] = preset
+
+    if type(state) == "table" then
+        state.selectedPresetName = targetName
+    end
+
+    return true, string.format('Imported saved raid team "%s".', targetName)
+end
+
+-- Raid assignments (all bosses + general): copy = only if raid is empty; overwrite = replace.
+function EasyAssignBackupShare.ApplyRaidAssignments(payload, data, mode)
+    local raidId = data.raidId
+    local existing = type(EasyAssignDB.assignments) == "table" and EasyAssignDB.assignments[raidId] or nil
+    local generalExisting = type(GetEasyAssignGeneralAssignmentsForRaid) == "function"
+        and GetEasyAssignGeneralAssignmentsForRaid(raidId) or {}
+    local occupied = (type(existing) == "table" and next(existing) ~= nil)
+        or (type(generalExisting) == "table" and next(generalExisting) ~= nil)
+
+    if mode == "copy" and occupied then
+        return false, string.format('%s already has assignments. Choose "Overwrite" to replace them.',
+            data.raidName or raidId)
+    end
+
+    if type(ApplyEasyAssignIncomingAssignmentSnapshot) == "function" then
+        ApplyEasyAssignIncomingAssignmentSnapshot(raidId, data.assignments, data.general, nil, true)
+    else
+        if type(EasyAssignDB.assignments) ~= "table" then
+            EasyAssignDB.assignments = {}
+        end
+        EasyAssignDB.assignments[raidId] = EasyAssignDeepCopyValue(data.assignments)
+    end
+
+    return true, string.format("Imported assignments for %s.", data.raidName or raidId)
+end
+
+-- Boss assignments: copy = only if that boss slot is empty; overwrite = replace.
+function EasyAssignBackupShare.ApplyBossAssignments(payload, data, mode)
+    local raidId, bossId = data.raidId, data.bossId
+    local raidStore = type(EasyAssignDB.assignments) == "table" and EasyAssignDB.assignments[raidId] or nil
+    local existing = type(raidStore) == "table" and raidStore[bossId] or nil
+    local occupied = type(existing) == "table" and next(existing) ~= nil
+
+    if mode == "copy" and occupied then
+        return false, string.format('%s already has assignments. Choose "Overwrite" to replace them.',
+            data.bossName or bossId)
+    end
+
+    if type(ApplyEasyAssignIncomingBossAssignmentScope) == "function" then
+        ApplyEasyAssignIncomingBossAssignmentScope(raidId, bossId, data.assignments, bossId)
+    else
+        if type(EasyAssignDB.assignments) ~= "table" then
+            EasyAssignDB.assignments = {}
+        end
+        if type(EasyAssignDB.assignments[raidId]) ~= "table" then
+            EasyAssignDB.assignments[raidId] = {}
+        end
+        EasyAssignDB.assignments[raidId][bossId] = EasyAssignDeepCopyValue(data.assignments)
+    end
+
+    return true, string.format("Imported assignments for %s.", data.bossName or bossId)
+end
+
+-- Boss map: copy = only if that boss map is empty; overwrite = replace.
+function EasyAssignBackupShare.ApplyBossMap(payload, data, mode)
+    local raidId, bossId = data.raidId, data.bossId
+    local raidStore = type(EasyAssignDB.placements) == "table" and EasyAssignDB.placements[raidId] or nil
+    local existing = type(raidStore) == "table" and raidStore[bossId] or nil
+    local occupied = type(existing) == "table" and next(existing) ~= nil
+
+    if mode == "copy" and occupied then
+        return false, string.format('%s already has a saved map. Choose "Overwrite" to replace it.',
+            data.bossName or bossId)
+    end
+
+    if type(ApplyEasyAssignIncomingBossMapScope) == "function" then
+        ApplyEasyAssignIncomingBossMapScope(raidId, bossId, data.placements)
+    else
+        if type(EasyAssignDB.placements) ~= "table" then
+            EasyAssignDB.placements = {}
+        end
+        if type(EasyAssignDB.placements[raidId]) ~= "table" then
+            EasyAssignDB.placements[raidId] = {}
+        end
+        EasyAssignDB.placements[raidId][bossId] = EasyAssignDeepCopyValue(data.placements)
+    end
+
+    return true, string.format("Imported map for %s.", data.bossName or bossId)
+end
+
+-- Settings: copy = fill missing keys only; overwrite = set all provided keys.
+-- Machine-specific keys are always filtered out of the incoming data.
+function EasyAssignBackupShare.ApplySettings(payload, data, mode)
+    local incoming = EasyAssignBackupShare.FilterSettings(data)
+
+    if next(incoming) == nil then
+        return false, "There are no importable settings in this backup."
+    end
+
+    if type(EasyAssignDB.settings) ~= "table" then
+        EasyAssignDB.settings = {}
+    end
+
+    local applied, skipped = 0, 0
+    for key, value in pairs(incoming) do
+        if mode == "overwrite" or EasyAssignDB.settings[key] == nil then
+            EasyAssignDB.settings[key] = value
+            applied = applied + 1
+        else
+            skipped = skipped + 1
+        end
+    end
+
+    if applied == 0 then
+        return false, "All of those settings already exist. Choose \"Overwrite\" to replace them."
+    end
+
+    if skipped > 0 then
+        return true, string.format("Imported %d setting(s); kept %d existing.", applied, skipped)
+    end
+
+    return true, string.format("Imported %d setting(s).", applied)
+end
+
+-- Everything: overwrite = full restore of portable sections; copy = additive restore
+-- that only fills portable sections whose target is absent/empty (never clobbers).
+-- Individual-team merging is intentionally handled by the per-team scope, not here.
+function EasyAssignBackupShare.ApplyEverything(payload, data, mode)
+    local appliedKeys, skippedKeys = {}, {}
+
+    for _, key in ipairs(EasyAssignBackupShare.PORTABLE_DB_KEYS) do
+        local incoming = data[key]
+
+        if incoming ~= nil then
+            if key == "settings" then
+                local incomingSettings = EasyAssignBackupShare.FilterSettings(incoming)
+                if type(EasyAssignDB.settings) ~= "table" then
+                    EasyAssignDB.settings = {}
+                end
+                local wroteAny = false
+                for sKey, sValue in pairs(incomingSettings) do
+                    if mode == "overwrite" or EasyAssignDB.settings[sKey] == nil then
+                        EasyAssignDB.settings[sKey] = sValue
+                        wroteAny = true
+                    end
+                end
+                if wroteAny then
+                    appliedKeys[#appliedKeys + 1] = key
+                else
+                    skippedKeys[#skippedKeys + 1] = key
+                end
+            else
+                local current = EasyAssignDB[key]
+                local currentEmpty = (current == nil)
+                    or (type(current) == "table" and next(current) == nil)
+
+                if mode == "overwrite" or currentEmpty then
+                    EasyAssignDB[key] = EasyAssignDeepCopyValue(incoming)
+                    appliedKeys[#appliedKeys + 1] = key
+                else
+                    skippedKeys[#skippedKeys + 1] = key
+                end
+            end
+        end
+    end
+
+    if #appliedKeys == 0 then
+        return false, "Nothing was imported. Your existing data was kept -- choose \"Overwrite\" to replace it."
+    end
+
+    if #skippedKeys > 0 then
+        return true, string.format("Restored %d section(s); kept %d existing (use Overwrite to replace those).",
+            #appliedKeys, #skippedKeys)
+    end
+
+    return true, string.format("Restored %d section(s) from the backup.", #appliedKeys)
+end
+
+-- =====================================================================================
+-- Chunk D: the Backup / Share panel + entry points
+-- =====================================================================================
+-- Self-contained overlay parented to mainFrame. Reuses the addon's frame/button/dropdown
+-- helpers and the generic transfer edit-box layout helper, but does NOT touch the
+-- assignment-profile transfer frames (keeps that tested flow isolated).
+
+function EasyAssignBackupShare.SetStatus(message, isError)
+    if not mainFrame or not mainFrame.backupShareStatusText then
+        return
+    end
+    mainFrame.backupShareStatusText:SetText(message or "")
+    mainFrame.backupShareStatusText:SetTextColor(isError and 1 or 0.72, isError and 0.35 or 0.92, isError and 0.35 or 0.72)
+end
+
+function EasyAssignBackupShare.SetBanner(text)
+    if mainFrame and mainFrame.backupShareBanner then
+        mainFrame.backupShareBanner:SetText(text or "")
+    end
+end
+
+-- Disarm the two-click overwrite confirmation whenever context changes.
+function EasyAssignBackupShare.Disarm()
+    if type(state) == "table" then
+        state.backupShareOverwriteArmed = false
+    end
+    if mainFrame and mainFrame.backupShareOverwriteButton and mainFrame.backupShareOverwriteButton.text then
+        mainFrame.backupShareOverwriteButton.text:SetText("Overwrite")
+    end
+end
+
+-- Resolve the human label for the currently-selected scope.
+function EasyAssignBackupShare.ScopeButtonLabel(scope)
+    if type(scope) ~= "table" then
+        return "Choose what to back up..."
+    end
+    if scope.kind == "everything" then
+        return "Everything (full setup)"
+    elseif scope.kind == "settings" then
+        return "Settings only"
+    elseif scope.kind == "team" then
+        return string.format('Saved team: %s', scope.teamName or "?")
+    elseif scope.kind == "raidAssignments" then
+        return string.format("Assignments: %s", scope.raidName or scope.raidId or "?")
+    elseif scope.kind == "bossAssignments" then
+        return string.format("Assignments: %s", scope.bossName or scope.bossId or "?")
+    elseif scope.kind == "bossMap" then
+        return string.format("Map: %s", scope.bossName or scope.bossId or "?")
+    end
+    return "Choose what to back up..."
+end
+
+function EasyAssignBackupShare.SetScope(scope)
+    if type(state) == "table" then
+        state.backupShareScope = scope
+    end
+    EasyAssignBackupShare.Disarm()
+    if mainFrame and mainFrame.backupShareScopeDropdown and type(SetAssignmentDropdownButtonState) == "function" then
+        SetAssignmentDropdownButtonState(
+            mainFrame.backupShareScopeDropdown,
+            EasyAssignBackupShare.ScopeButtonLabel(scope),
+            nil, false, EasyAssignBackupShare.BuildScopeMenu)
+    end
+    EasyAssignBackupShare.SetStatus("", false)
+end
+
+-- Build the grouped scope menu, reflecting the current raid/boss selection and saved teams.
+function EasyAssignBackupShare.BuildScopeMenu()
+    local menu = {}
+    local selectedRaid = type(GetSelectedRaid) == "function" and GetSelectedRaid() or nil
+    local selectedBoss = type(GetSelectedBoss) == "function" and GetSelectedBoss() or nil
+
+    menu[#menu + 1] = {
+        text = "Everything (full setup)",
+        func = function()
+            CloseDropDownMenus()
+            EasyAssignBackupShare.SetScope({ kind = "everything" })
+        end,
+        notCheckable = true,
+    }
+    menu[#menu + 1] = {
+        text = "Settings only",
+        func = function()
+            CloseDropDownMenus()
+            EasyAssignBackupShare.SetScope({ kind = "settings" })
+        end,
+        notCheckable = true,
+    }
+
+    menu[#menu + 1] = { text = "Current selection", isTitle = true, notCheckable = true }
+
+    if selectedRaid and type(selectedRaid.id) == "string" then
+        menu[#menu + 1] = {
+            text = string.format("This raid's assignments (%s)", selectedRaid.name or selectedRaid.id),
+            func = function()
+                CloseDropDownMenus()
+                EasyAssignBackupShare.SetScope({ kind = "raidAssignments", raidId = selectedRaid.id, raidName = selectedRaid.name })
+            end,
+            notCheckable = true,
+        }
+
+        if selectedBoss and type(selectedBoss.id) == "string" then
+            menu[#menu + 1] = {
+                text = string.format("This boss's assignments (%s)", selectedBoss.name or selectedBoss.id),
+                func = function()
+                    CloseDropDownMenus()
+                    EasyAssignBackupShare.SetScope({ kind = "bossAssignments", raidId = selectedRaid.id, raidName = selectedRaid.name, bossId = selectedBoss.id, bossName = selectedBoss.name })
+                end,
+                notCheckable = true,
+            }
+            menu[#menu + 1] = {
+                text = string.format("This boss's map (%s)", selectedBoss.name or selectedBoss.id),
+                func = function()
+                    CloseDropDownMenus()
+                    EasyAssignBackupShare.SetScope({ kind = "bossMap", raidId = selectedRaid.id, raidName = selectedRaid.name, bossId = selectedBoss.id, bossName = selectedBoss.name })
+                end,
+                notCheckable = true,
+            }
+        else
+            menu[#menu + 1] = { text = "Select a boss for boss scopes", disabled = true, notCheckable = true }
+        end
+    else
+        menu[#menu + 1] = { text = "Select a raid for raid/boss scopes", disabled = true, notCheckable = true }
+    end
+
+    -- Saved raid teams group.
+    local presets = type(EasyAssignDB) == "table" and type(EasyAssignDB.presets) == "table" and EasyAssignDB.presets or {}
+    local names = {}
+    for name in pairs(presets) do
+        if type(name) == "string" then
+            names[#names + 1] = name
+        end
+    end
+    table.sort(names)
+
+    menu[#menu + 1] = { text = "Saved raid teams", isTitle = true, notCheckable = true }
+    if #names == 0 then
+        menu[#menu + 1] = { text = "No saved teams yet", disabled = true, notCheckable = true }
+    else
+        for _, name in ipairs(names) do
+            local teamName = name
+            menu[#menu + 1] = {
+                text = teamName,
+                func = function()
+                    CloseDropDownMenus()
+                    EasyAssignBackupShare.SetScope({ kind = "team", teamName = teamName })
+                end,
+                notCheckable = true,
+            }
+        end
+    end
+
+    return menu
+end
