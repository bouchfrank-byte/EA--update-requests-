+-- =====================================================================================
+-- Easy Assign - Missing-Player Check (Step 2)
+-- =====================================================================================
+-- Self-contained. On import (and on roster change / UNIT_CONNECTION) it diffs every
+-- assigned player referenced anywhere in the LIVE assignment structure against the live
+-- raid (name-only match) and surfaces WHO is missing AND WHAT they were assigned, each
+-- entry clickable to jump straight to that assignment slot for reassignment.
+--
+-- Slot budget (Lua 5.1): like Step 1, EVERYTHING lives on the global table
+-- EasyAssignMissingCheck and reads existing chunk-locals/globals (mainFrame, state,
+-- raids, backdropTemplate, SetPanelBackdrop, GetShortPlayerName, EnsureAssignmentList,
+-- the GetMyAssignments* accessors, the roster-lookup helpers, SelectRaid/SelectBoss/
+-- SelectMainMenu, ...). No new top-level locals are declared.
+--
+-- Detection reuses the SAME accessors and missing-filter semantics as the existing
+-- preset-load warning (BuildMissingAssignmentWarningLinesForTemplate) so results match
+-- what the addon already shows on preset load -- but organized BY PLAYER with per-slot
+-- jump coordinates instead of by-boss text lines.
+-- =====================================================================================
+
+EasyAssignMissingCheck = EasyAssignMissingCheck or {}
+
+-- Build the "present players" lookup from the live raid/group (reuses Step-1-era wiring).
+-- Returns lookup(table name->true), hasRoster(boolean).
+function EasyAssignMissingCheck.BuildRosterLookup()
+    local members = type(GetCurrentRaidMembersForAssignmentLoadWarning) == "function"
+        and GetCurrentRaidMembersForAssignmentLoadWarning() or {}
+    local lookup = type(BuildAssignmentLoadRosterLookup) == "function"
+        and BuildAssignmentLoadRosterLookup(members) or {}
+
+    return lookup, (next(lookup) ~= nil)
+end
+
+-- Aggregate one (missing player, slot) record into the collector, grouped by player and
+-- then by (raid, boss) location, with de-duplicated context labels.
+function EasyAssignMissingCheck.AddRecord(collector, player, raidId, raidName, bossId, bossName, orderIndex, context)
+    if type(collector) ~= "table" or type(player) ~= "string" or player == "" then
+        return
+    end
+
+    local entry = collector.byPlayer[player]
+
+    if not entry then
+        entry = {
+            name = player,
+            order = collector.nextPlayerOrder,
+            locations = {},
+            locationIndex = {},
+        }
+        collector.nextPlayerOrder = collector.nextPlayerOrder + 1
+        collector.byPlayer[player] = entry
+        collector.players[#collector.players + 1] = entry
+    end
+
+    local locKey = tostring(raidId) .. "\001" .. tostring(bossId)
+    local location = entry.locationIndex[locKey]
+
+    if not location then
+        location = {
+            raidId = raidId,
+            raidName = raidName,
+            bossId = bossId,
+            bossName = bossName,
+            order = orderIndex or 0,
+            contexts = {},
+            contextSeen = {},
+        }
+        entry.locationIndex[locKey] = location
+        entry.locations[#entry.locations + 1] = location
+    end
+
+    if type(context) == "string" and context ~= "" and not location.contextSeen[context] then
+        location.contextSeen[context] = true
+        location.contexts[#location.contexts + 1] = context
+    end
+end
+
+-- Walk one resolved template (boss or general), emitting a record for every assigned
+-- player that is NOT in the roster. Mirrors BuildMissingAssignmentWarningLinesForTemplate
+-- field-for-field so detection stays consistent with the shipped preset-load warning.
+function EasyAssignMissingCheck.WalkTemplate(collector, rosterLookup, raidId, raidName, bossId, bossName, orderIndex, template, bossStore, generalStore)
+    if type(template) ~= "table" or type(rosterLookup) ~= "table" then
+        return
+    end
+
+    local function emitList(values, context)
+        for _, value in ipairs(EnsureAssignmentList(values, 0)) do
+            local name = GetShortPlayerName(value or "")
+
+            if name ~= "" and not rosterLookup[name] then
+                EasyAssignMissingCheck.AddRecord(collector, name, raidId, raidName, bossId, bossName, orderIndex, context)
+            end
+        end
+    end
+
+    local function emitSingle(value, context)
+        local name = GetShortPlayerName(value or "")
+
+        if name ~= "" and not rosterLookup[name] then
+            EasyAssignMissingCheck.AddRecord(collector, name, raidId, raidName, bossId, bossName, orderIndex, context)
+        end
+    end
+
+    -- Boss sections: tanks, misdirects, per-ability control assignments. The section name
+    -- is only added to disambiguate bosses that have more than one tank/misdirect section
+    -- (single-section bosses read cleanly, e.g. "MT on Hydross").
+    local tankSectionCount = 0
+    local misdirectSectionCount = 0
+
+    for _, section in ipairs(template.sections or {}) do
+        if section.showTanks ~= false then
+            tankSectionCount = tankSectionCount + 1
+        end
+
+        if section.misdirects ~= false then
+            misdirectSectionCount = misdirectSectionCount + 1
+        end
+    end
+
+    for _, section in ipairs(template.sections or {}) do
+        local phasePrefix = GetMyAssignmentsPhasePrefix(template, section)
+        local sectionName = section.name or ""
+
+        if section.showTanks ~= false then
+            local tankLabel = section.tankLabel or "Tank"
+            local tankContext = phasePrefix .. tankLabel
+
+            if tankSectionCount > 1 and sectionName ~= "" then
+                tankContext = phasePrefix .. string.format("%s (%s)", tankLabel, sectionName)
+            end
+
+            emitList(GetMyAssignmentsBossSectionList(template, bossStore, generalStore, section.id, "tanks", 1), tankContext)
+        end
+
+        if section.misdirects ~= false then
+            local misdirectContext = phasePrefix .. "Misdirect"
+
+            if misdirectSectionCount > 1 and sectionName ~= "" then
+                misdirectContext = phasePrefix .. string.format("Misdirect (%s)", sectionName)
+            end
+
+            emitList(GetMyAssignmentsBossSectionList(template, bossStore, generalStore, section.id, "misdirects", 1), misdirectContext)
+        end
+
+        for _, ability in ipairs(section.abilities or {}) do
+            local abilityName = ability.name or ability.controlLabel or "Ability"
+            emitList(GetMyAssignmentsBossAbilityAssignments(bossStore, section.id, ability.id, 1), phasePrefix .. abilityName)
+        end
+    end
+
+    -- Utility fields (everything except healer target/healer pairs, handled below).
+    for _, field in ipairs(template.utility or {}) do
+        if not IsTemplateHealerUtilityField(field) then
+            local phasePrefix = GetMyAssignmentsPhasePrefix(template, field)
+            local label = phasePrefix .. (field.label or "Assignment")
+
+            if field.customAssignment then
+                for _, segment in ipairs(field.segments or {}) do
+                    if type(segment) == "table" and segment.type == "player" then
+                        emitList(GetMyAssignmentsBossUtilityList(bossStore, generalStore, segment.id, 1), label)
+                    end
+                end
+            elseif field.choices then
+                -- Choice fields never assign players.
+            elseif field.symbolListFieldId or field.symbolFieldId or field.targetListFieldId
+                or DoesTemplateUtilityFieldUseListAssignments(field) or field.fixedRosterTargets then
+                emitList(GetMyAssignmentsBossUtilityList(bossStore, generalStore, field.id, 1), label)
+            else
+                emitSingle(GetMyAssignmentsBossUtilityField(bossStore, generalStore, field.id), label)
+            end
+        end
+    end
+
+    -- Healer target/healer pairs (index-paired lists). Skip shared-profile templates,
+    -- matching the preset-load warning.
+    if template.assignmentProfileSource ~= "shared" then
+        local targets = GetMyAssignmentsBossUtilityList(bossStore, generalStore, "healer-assignment-targets", 1)
+        local healers = GetMyAssignmentsBossUtilityList(bossStore, generalStore, "healer-assignment-healers", 1)
+
+        for index, healerName in ipairs(EnsureAssignmentList(healers, 0)) do
+            local name = GetShortPlayerName(healerName or "")
+
+            if name ~= "" and not rosterLookup[name] then
+                local targetLabel = GetHealerAssignmentTargetLabel(template, targets[index] or "")
+                local context = targetLabel ~= "" and ("Healer " .. targetLabel) or "Healer"
+                EasyAssignMissingCheck.AddRecord(collector, name, raidId, raidName, bossId, bossName, orderIndex, context)
+            end
+        end
+    end
+end
+
+-- Walk the whole LIVE assignment structure across every raid (general + each boss in
+-- popup boss order) and return a structured, player-grouped result:
+--   { hasRoster, count, players = { { name, summary, locations = {
+--         { raidId, raidName, bossId, bossName, contexts = {..}, summary } } } } }
+function EasyAssignMissingCheck.Compute()
+    local rosterLookup, hasRoster = EasyAssignMissingCheck.BuildRosterLookup()
+
+    local result = {
+        hasRoster = hasRoster,
+        count = 0,
+        players = {},
+    }
+
+    if not hasRoster or type(raids) ~= "table" then
+        return result
+    end
+
+    local collector = {
+        byPlayer = {},
+        players = {},
+        nextPlayerOrder = 1,
+    }
+    local orderIndex = 0
+
+    for _, raid in ipairs(raids) do
+        if type(raid) == "table" and type(raid.id) == "string" then
+            local raidName = raid.name or raid.id
+            local assignmentsByBoss = type(GetEasyAssignRaidAssignmentsForRaid) == "function"
+                and GetEasyAssignRaidAssignmentsForRaid(raid.id) or nil
+            local generalStore = type(GetEasyAssignGeneralAssignmentsForRaid) == "function"
+                and GetEasyAssignGeneralAssignmentsForRaid(raid.id) or nil
+
+            -- General raid assignments (own jumpable slot, boss index 0).
+            local generalTemplate = ResolveBossAssignmentTemplate(
+                assignmentTemplates["general-raid-assignments"], generalStore, false, "general-raid-assignments")
+
+            if type(generalTemplate) == "table" then
+                if type(generalStore) == "table" then
+                    MigrateBossAssignmentStore(generalStore, generalTemplate)
+                end
+
+                orderIndex = orderIndex + 1
+                EasyAssignMissingCheck.WalkTemplate(collector, rosterLookup, raid.id, raidName,
+                    "general-raid-assignments", "General Raid Assignments", orderIndex,
+                    generalTemplate, generalStore, generalStore)
+            end
+
+            for _, bossId in ipairs(GetRaidPopupBossOrder(raid) or {}) do
+                local bossStore = type(assignmentsByBoss) == "table" and assignmentsByBoss[bossId] or nil
+                local template = GetResolvedBossAssignmentTemplateForStore(bossId, bossStore)
+
+                if type(template) == "table" then
+                    if type(bossStore) == "table" then
+                        MigrateBossAssignmentStore(bossStore, template)
+                    end
+
+                    local boss = GetBossById(raid, bossId)
+                    local bossName = type(boss) == "table" and (boss.name or bossId) or bossId
+
+                    if type(template.variantName) == "string" and template.variantName ~= "" then
+                        bossName = string.format("%s - %s", bossName, template.variantName)
+                    end
+
+                    orderIndex = orderIndex + 1
+                    EasyAssignMissingCheck.WalkTemplate(collector, rosterLookup, raid.id, raidName,
+                        bossId, bossName, orderIndex, template, bossStore, generalStore)
+                end
+            end
+        end
+    end
+
+    -- Finalize: sort players by name, sort each player's locations by walk order, and
+    -- pre-build human-readable summaries ("MT on Hydross, Misdirect on Karathress").
+    table.sort(collector.players, function(a, b)
+        return (a.name or "") < (b.name or "")
+    end)
+
+    for _, entry in ipairs(collector.players) do
+        table.sort(entry.locations, function(a, b)
+            return (a.order or 0) < (b.order or 0)
+        end)
+
+        local locationSummaries = {}
+
+        for _, location in ipairs(entry.locations) do
+            local contexts = table.concat(location.contexts, ", ")
+            location.summary = contexts ~= "" and string.format("%s on %s", contexts, location.bossName)
+                or location.bossName
+            locationSummaries[#locationSummaries + 1] = location.summary
+        end
+
+        entry.summary = table.concat(locationSummaries, ", ")
+        entry.locationIndex = nil
+        entry.contextSeen = nil
+    end
+
+    result.players = collector.players
+    result.count = #collector.players
+
+    return result
+end
+
+-- A short, spec-style one-liner for chat/status ("3 not in raid: Bob (...), Sue (...)").
+function EasyAssignMissingCheck.BuildChatSummary(result)
+    if type(result) ~= "table" or not result.hasRoster then
+        return "Join a raid or group to check for missing assigned players."
+    end
+
+    if result.count == 0 then
+        return "All assigned players are in the raid."
+    end
+
+    local parts = {}
+    local shown = math.min(result.count, 6)
+
+    for index = 1, shown do
+        local entry = result.players[index]
+        parts[#parts + 1] = string.format("%s (%s)", entry.name, entry.summary)
+    end
+
+    local suffix = ""
+
+    if result.count > shown then
+        suffix = string.format(", +%d more", result.count - shown)
+    end
+
+    return string.format("%d assigned player(s) not in raid: %s%s",
+        result.count, table.concat(parts, ", "), suffix)
+end
+
+-- =====================================================================================
+-- Step 2 - Missing-Player results window (clickable jump-to-slot) + navigation
+-- =====================================================================================
+-- Self-contained overlay parented to mainFrame, styled with the same frame/button
+-- helpers Step 1 uses. Rows are pooled: a per-player "header" row plus one clickable
+-- "link" row per (boss) location that jumps straight to that assignment slot.
+
+-- Navigate to a specific assignment slot: main menu -> raid -> boss (assignments page).
+function EasyAssignMissingCheck.Jump(raidId, bossId)
+    EasyAssignMissingCheck.Hide()
+
+    if not mainFrame then
+        return
+    end
+
+    if mainFrame.IsShown and not mainFrame:IsShown() then
+        mainFrame:Show()
+
+        if mainFrame.Raise then
+            mainFrame:Raise()
+        end
+    end
+
+    if type(SelectMainMenu) == "function" then
+        SelectMainMenu("raids")
+    end
+
+    local raidIndex
+
+    for index, raid in ipairs(raids or {}) do
+        if raid.id == raidId then
+            raidIndex = index
+            break
+        end
+    end
+
+    if raidIndex and type(SelectRaid) == "function" then
+        SelectRaid(raidIndex)
+    end
+
+    local bossIndex
+
+    if bossId == "general-raid-assignments" then
+        bossIndex = 0
+    elseif raidIndex then
+        local raid = raids[raidIndex]
+        local trashBossId = type(GetTrashAssignmentsBossId) == "function"
+            and GetTrashAssignmentsBossId(raid and raid.id or "") or nil
+
+        if trashBossId and bossId == trashBossId then
+            bossIndex = -1
+        elseif type(raid) == "table" then
+            for index, boss in ipairs(raid.bosses or {}) do
+                if boss.id == bossId then
+                    bossIndex = index
+                    break
+                end
+            end
+        end
+    end
+
+    if bossIndex ~= nil and type(SelectBoss) == "function" then
+        SelectBoss(bossIndex)
+    end
+
+    if type(state) == "table" then
+        state.selectedPreviewPage = "assignments"
+    end
+end
+
+-- Visual state for a link (clickable) row.
+function EasyAssignMissingCheck.UpdateLinkRowVisual(row)
+    if not row then
+        return
+    end
+
+    if row.isHovered then
+        row:SetBackdropColor(0.16, 0.20, 0.30, 0.95)
+        row:SetBackdropBorderColor(0.42, 0.52, 0.72, 1)
+    else
+        row:SetBackdropColor(0.10, 0.11, 0.15, 0.6)
+        row:SetBackdropBorderColor(0.24, 0.26, 0.32, 1)
+    end
+end
+
+-- Lazily create + return a pooled row button.
+function EasyAssignMissingCheck.AcquireRow(index)
+    if not mainFrame or not mainFrame.missingCheckScrollChild then
+        return nil
+    end
+
+    mainFrame.missingCheckRows = mainFrame.missingCheckRows or {}
+
+    local row = mainFrame.missingCheckRows[index]
+
+    if row then
+        return row
+    end
+
+    row = CreateFrame("Button", nil, mainFrame.missingCheckScrollChild, backdropTemplate)
+    row:SetHeight(22)
+    row:RegisterForClicks("LeftButtonUp")
+    SetPanelBackdrop(row, 0.10, 0.11, 0.15, 0.6)
+    row:SetBackdropBorderColor(0, 0, 0, 0)
+
+    row.text = row:CreateFontString(nil, "OVERLAY", "GameFontHighlightSmall")
+    row.text:SetPoint("LEFT", 8, 0)
+    row.text:SetPoint("RIGHT", -8, 0)
+    row.text:SetJustifyH("LEFT")
+
+    row:SetScript("OnClick", function(self)
+        if self.rowKind == "link" and type(self.jumpRaidId) == "string" and type(self.jumpBossId) == "string" then
+            if type(pcall) == "function" then
+                pcall(EasyAssignMissingCheck.Jump, self.jumpRaidId, self.jumpBossId)
+            else
+                EasyAssignMissingCheck.Jump(self.jumpRaidId, self.jumpBossId)
+            end
+        end
+    end)
+    row:SetScript("OnEnter", function(self)
+        if self.rowKind == "link" then
+            self.isHovered = true
+            EasyAssignMissingCheck.UpdateLinkRowVisual(self)
+        end
+    end)
+    row:SetScript("OnLeave", function(self)
+        self.isHovered = false
+
+        if self.rowKind == "link" then
+            EasyAssignMissingCheck.UpdateLinkRowVisual(self)
+        end
+    end)
+
+    mainFrame.missingCheckRows[index] = row
+
+    return row
+end
+
+-- Configure a pooled row for either a player "header" or a clickable "link".
+function EasyAssignMissingCheck.StyleRow(row, item, width, yOffset)
+    if not row or type(item) ~= "table" then
+        return 0
+    end
+
+    row.rowKind = item.kind
+    row.jumpRaidId = item.raidId
+    row.jumpBossId = item.bossId
+    row.isHovered = false
+
+    row:ClearAllPoints()
+    row:SetPoint("TOPLEFT", 0, -yOffset)
+    row:SetWidth(math.max(width or 1, 1))
+
+    if item.kind == "header" then
+        row:SetHeight(24)
+        row:EnableMouse(false)
+        row:SetBackdropColor(0, 0, 0, 0)
+        row:SetBackdropBorderColor(0, 0, 0, 0)
+        row.text:ClearAllPoints()
+        row.text:SetPoint("LEFT", 4, 0)
+        row.text:SetPoint("RIGHT", -8, 0)
+        row.text:SetText(item.text or "")
+        row:Show()
+        return 26
+    end
+
+    row:SetHeight(22)
+    row:EnableMouse(true)
+    row.text:ClearAllPoints()
+    row.text:SetPoint("LEFT", 18, 0)
+    row.text:SetPoint("RIGHT", -8, 0)
+    row.text:SetText(item.text or "")
+    EasyAssignMissingCheck.UpdateLinkRowVisual(row)
+    row:Show()
+
+    return 24
+end
+
+-- Build the flat row-item list from a computed result (header + link rows per player).
+function EasyAssignMissingCheck.BuildRowItems(result)
+    local items = {}
+
+    if type(result) ~= "table" then
+        return items
+    end
+
+    for _, entry in ipairs(result.players or {}) do
+        local slotCount = #entry.locations
+        items[#items + 1] = {
+            kind = "header",
+            text = string.format("|cffffd200%s|r  |cff9aa4b2- not in raid (%d slot%s)|r",
+                entry.name, slotCount, slotCount == 1 and "" or "s"),
+        }
+
+        for _, location in ipairs(entry.locations) do
+            local contexts = table.concat(location.contexts, ", ")
+            items[#items + 1] = {
+                kind = "link",
+                raidId = location.raidId,
+                bossId = location.bossId,
+                text = string.format("|cffbfd4ff->|r %s   |cff9aa4b2%s|r", location.bossName, contexts),
+            }
+        end
+    end
+
+    return items
+end
+
+-- Populate the window from a result (recomputing if none supplied).
+function EasyAssignMissingCheck.Populate(result)
+    if not mainFrame or not mainFrame.missingCheckOverlay then
+        return
+    end
+
+    result = result or EasyAssignMissingCheck.Compute()
+    mainFrame.missingCheckLastResult = result
+
+    local header = mainFrame.missingCheckHeaderText
+
+    if header then
+        if type(result) ~= "table" or not result.hasRoster then
+            header:SetText("Join a raid or group to check for missing assigned players.")
+        elseif result.count == 0 then
+            header:SetText("|cff66dd66All assigned players are in the raid.|r")
+        else
+            header:SetText(string.format(
+                "|cffff8888%d|r assigned player(s) are not in the raid. Click an entry to jump to it and reassign.",
+                result.count))
+        end
+    end
+
+    -- Hide all pooled rows first.
+    for _, row in ipairs(mainFrame.missingCheckRows or {}) do
+        row:Hide()
+        row:EnableMouse(true)
+    end
+
+    local scrollFrame = mainFrame.missingCheckScrollFrame
+    local scrollChild = mainFrame.missingCheckScrollChild
+    local width = math.max((scrollFrame and scrollFrame:GetWidth() or 0) - 6, 1)
+    local items = EasyAssignMissingCheck.BuildRowItems(result)
+    local yOffset = 0
+
+    if scrollChild then
+        scrollChild:SetWidth(width)
+    end
+
+    for index, item in ipairs(items) do
+        local row = EasyAssignMissingCheck.AcquireRow(index)
+
+        if row then
+            yOffset = yOffset + EasyAssignMissingCheck.StyleRow(row, item, width, yOffset)
+        end
+    end
+
+    if scrollChild then
+        scrollChild:SetHeight(math.max(yOffset, 1))
+    end
+
+    if scrollFrame then
+        scrollFrame:SetVerticalScroll(0)
+
+        if type(UpdateScrollFrameScrollBarVisibility) == "function" then
+            UpdateScrollFrameScrollBarVisibility(scrollFrame)
+        end
+    end
+end
+
+-- Build the window once.
+function EasyAssignMissingCheck.Create(parent)
+    if not mainFrame or mainFrame.missingCheckOverlay or not parent then
+        return
+    end
+
+    local overlay = CreateFrame("Frame", nil, parent, backdropTemplate)
+    overlay:SetAllPoints(parent)
+    overlay:SetFrameStrata("FULLSCREEN_DIALOG")
+    overlay:SetFrameLevel((parent:GetFrameLevel() or 0) + 40)
+    overlay:EnableMouse(true)
+    SetPanelBackdrop(overlay, 0.02, 0.03, 0.04, 0.52)
+    overlay:SetBackdropBorderColor(0, 0, 0, 0)
+    overlay:Hide()
+    mainFrame.missingCheckOverlay = overlay
+
+    local popup = CreateFrame("Frame", nil, overlay, backdropTemplate)
+    popup:SetSize(640, 460)
+    popup:SetPoint("CENTER", parent, "CENTER", 0, 0)
+    popup:SetFrameLevel((overlay:GetFrameLevel() or 0) + 2)
+    SetPanelBackdrop(popup, 0.04, 0.05, 0.07, 0.98)
+    CreateDefaultRosterOutline(popup)
+    ApplyDefaultRosterContainerOutline(popup)
+    SetDefaultRosterOutlineColor(popup, 0.34, 0.36, 0.42, 1)
+    mainFrame.missingCheckPopup = popup
+
+    local title = popup:CreateFontString(nil, "OVERLAY", "GameFontNormal")
+    title:SetPoint("TOPLEFT", 14, -12)
+    title:SetPoint("TOPRIGHT", -14, -12)
+    title:SetJustifyH("LEFT")
+    title:SetText("Players Not In Raid")
+
+    local headerText = popup:CreateFontString(nil, "OVERLAY", "GameFontHighlightSmall")
+    headerText:SetPoint("TOPLEFT", title, "BOTTOMLEFT", 0, -6)
+    headerText:SetPoint("TOPRIGHT", -14, -30)
+    headerText:SetJustifyH("LEFT")
+    headerText:SetJustifyV("TOP")
+    headerText:SetText("")
+    mainFrame.missingCheckHeaderText = headerText
+
+    local listPanel = CreateFrame("Frame", nil, popup, backdropTemplate)
+    listPanel:SetPoint("TOPLEFT", popup, "TOPLEFT", 14, -64)
+    listPanel:SetPoint("BOTTOMRIGHT", popup, "BOTTOMRIGHT", -14, 52)
+    SetPanelBackdrop(listPanel, 0.08, 0.09, 0.12, 0.92)
+    CreateDefaultRosterOutline(listPanel)
+    ApplyDefaultRosterContainerOutline(listPanel)
+    SetDefaultRosterOutlineColor(listPanel, 0.28, 0.30, 0.36, 1)
+    mainFrame.missingCheckListPanel = listPanel
+
+    local scrollFrame = CreateFrame("ScrollFrame", nil, listPanel, "UIPanelScrollFrameTemplate")
+    scrollFrame:SetPoint("TOPLEFT", 8, -8)
+    scrollFrame:SetPoint("BOTTOMRIGHT", -26, 8)
+    scrollFrame.easyAssignHideScrollButtons = true
+    scrollFrame:EnableMouseWheel(true)
+    scrollFrame:SetScript("OnMouseWheel", function(self, delta)
+        local child = mainFrame.missingCheckScrollChild
+        local maxScroll = math.max(((child and child:GetHeight()) or 0) - (self:GetHeight() or 0), 0)
+        self:SetVerticalScroll(math.max(math.min((self:GetVerticalScroll() or 0) - (delta * 24), maxScroll), 0))
+
+        if type(UpdateScrollFrameScrollBarVisibility) == "function" then
+            UpdateScrollFrameScrollBarVisibility(self)
+        end
+    end)
+    mainFrame.missingCheckScrollFrame = scrollFrame
+
+    local scrollChild = CreateFrame("Frame", nil, scrollFrame)
+    scrollChild:SetWidth(560)
+    scrollChild:SetHeight(1)
+    scrollFrame:SetScrollChild(scrollChild)
+    mainFrame.missingCheckScrollChild = scrollChild
+
+    scrollFrame:SetScript("OnSizeChanged", function(self)
+        if mainFrame.missingCheckScrollChild then
+            mainFrame.missingCheckScrollChild:SetWidth(math.max((self:GetWidth() or 0) - 6, 1))
+        end
+    end)
+
+    if type(ApplyAddonScrollBarStyle) == "function" then
+        ApplyAddonScrollBarStyle(scrollFrame)
+    end
+
+    local closeButton = CreateAddonActionButton(popup, 82, "Close", function()
+        EasyAssignMissingCheck.Hide()
+    end)
+    closeButton:SetPoint("BOTTOMRIGHT", -14, 14)
+
+    local refreshButton = CreateAddonActionButton(popup, 96, "Refresh", function()
+        EasyAssignMissingCheck.Populate(EasyAssignMissingCheck.Compute())
+    end)
+    refreshButton:SetPoint("RIGHT", closeButton, "LEFT", -6, 0)
+end
+
+function EasyAssignMissingCheck.IsShown()
+    return mainFrame and mainFrame.missingCheckOverlay and mainFrame.missingCheckOverlay:IsShown() and true or false
+end
+
+function EasyAssignMissingCheck.Hide()
+    if mainFrame and mainFrame.missingCheckOverlay then
+        mainFrame.missingCheckOverlay:Hide()
+    end
+end
+
+function EasyAssignMissingCheck.Open(result)
+    if not mainFrame then
+        if type(print) == "function" then
+            print("Easy Assign: open the main window first, then try the missing-player check.")
+        end
+        return
+    end
+
+    if not mainFrame.missingCheckOverlay then
+        EasyAssignMissingCheck.Create(mainFrame)
+    end
+
+    if not mainFrame.missingCheckOverlay then
+        return
+    end
+
+    if mainFrame.IsShown and mainFrame:IsShown() == false then
+        mainFrame:Show()
+    end
+
+    EasyAssignMissingCheck.Populate(result or EasyAssignMissingCheck.Compute())
+    mainFrame.missingCheckOverlay:Show()
+    mainFrame.missingCheckOverlay:Raise()
+
+    if mainFrame.missingCheckPopup then
+        mainFrame.missingCheckPopup:Raise()
+    end
+end
+
+function EasyAssignMissingCheck.Toggle()
+    if EasyAssignMissingCheck.IsShown() then
+        EasyAssignMissingCheck.Hide()
+    else
+        EasyAssignMissingCheck.Open()
+    end
+end
+
+-- =====================================================================================
+-- Step 2 - Triggers: run on import, and refresh live on roster / UNIT_CONNECTION change
+-- =====================================================================================
+
+-- Run after a successful Backup/Share import. Only scopes that write LIVE assignments
+-- carry jumpable player slots; team/settings/bossMap are skipped (team missing-players
+-- are already surfaced by the existing preset-load warning when the team is loaded).
+-- Run the missing-player check after an officer PUSHES/shares assignments. This is the main sharing
+-- path now (the Share button / snapshot), so without this an officer gets no warning that an assigned
+-- player is not actually in the raid. Surfaces the clickable window + a chat summary when any are missing.
+function EasyAssignMissingCheck.OnPush()
+    local result = EasyAssignMissingCheck.Compute()
+
+    if type(result) ~= "table" or not result.hasRoster then
+        return
+    end
+
+    if result.count > 0 then
+        EasyAssignMissingCheck.Open(result)
+
+        if type(print) == "function" then
+            print("|cff66ccffEasy Assign|r " .. EasyAssignMissingCheck.BuildChatSummary(result))
+        end
+    end
+end
+
+-- Is this assignee a real player who is not currently in the raid? Uses the cached roster lookup that
+-- RefreshHighlightData maintains. Returns false when there is no roster (solo/party) so nothing lights up.
+function EasyAssignMissingCheck.IsNameMissing(name)
+    if type(name) ~= "string" or name == "" then return false end
+    local set = EasyAssignMissingCheck.currentMissingPlayerSet
+    if type(set) ~= "table" then return false end
+    -- Match only against names the missing-check flagged as absent PLAYERS. Because that check walks
+    -- player fields only (never healer targets / groups / roles), values like "Group 1", "Raid Heal",
+    -- or "Select target" are never in the set, so those dropdowns never glow.
+    local short = type(GetShortPlayerName) == "function" and GetShortPlayerName(name) or name
+    return short ~= "" and set[short] == true
+end
+
+-- Recompute both highlight sets in one pass: bosses (in the selected raid) that hold a not-in-raid
+-- assignee, and the set of missing player NAMES (used for the per-slot glow). Cheap; run at render time
+-- so the highlights can never be left stale after an edit.
+function EasyAssignMissingCheck.RecomputeSets()
+    local raid = type(GetSelectedRaid) == "function" and GetSelectedRaid() or nil
+    local raidId = type(raid) == "table" and raid.id or nil
+    local result = EasyAssignMissingCheck.Compute()
+    local bossSet, playerSet = {}, {}
+    if type(result) == "table" and type(result.players) == "table" then
+        for _, player in ipairs(result.players) do
+            if type(player.name) == "string" and player.name ~= "" then
+                playerSet[player.name] = true
+            end
+            for _, loc in ipairs(player.locations or {}) do
+                if loc.raidId == raidId and loc.bossId then
+                    bossSet[loc.bossId] = true
+                end
+            end
+        end
+    end
+    EasyAssignMissingCheck.currentMissingBossSet = bossSet
+    EasyAssignMissingCheck.currentMissingPlayerSet = playerSet
+end
+
+-- External trigger (roster change, push, raid switch, reassign): recompute now and re-render both the
+-- boss list and the assignment panel so both highlight levels update immediately.
+function EasyAssignMissingCheck.RefreshHighlightData()
+    EasyAssignMissingCheck.RecomputeSets()
+    if type(RefreshBossButtons) == "function" then RefreshBossButtons() end
+    if type(RefreshAssignments) == "function" then RefreshAssignments() end
+end
+
+function EasyAssignMissingCheck.OnImport(payload)
+    local scope = type(payload) == "table" and payload.scope or nil
+
+    if scope ~= "raidAssignments" and scope ~= "bossAssignments" and scope ~= "everything" then
+        return
+    end
+
+    local result = EasyAssignMissingCheck.Compute()
+
+    if type(result) ~= "table" or not result.hasRoster then
+        return
+    end
+
+    if result.count > 0 then
+        EasyAssignMissingCheck.Open(result)
+
+        if type(print) == "function" then
+            print("|cff66ccffEasy Assign|r " .. EasyAssignMissingCheck.BuildChatSummary(result))
+        end
+    elseif type(print) == "function" then
+        print("|cff66ccffEasy Assign|r All assigned players are in the raid.")
+    end
+
+    EasyAssignMissingCheck.RefreshHighlightData()
+end
+
+-- Refresh the list live when the roster or a member's connection changes -- but only if
+-- the window is already open (never pop a window mid-raid). Debounced to coalesce the
+-- bursts of GROUP_ROSTER_UPDATE / UNIT_CONNECTION events.
+function EasyAssignMissingCheck.OnRosterChange()
+    -- Always refresh the ambient boss-tab highlights when the roster changes (people joining/leaving),
+    -- independent of whether the popup list is open.
+    EasyAssignMissingCheck.RefreshHighlightData()
+
+    if not EasyAssignMissingCheck.IsShown() then
+        return
+    end
+
+    if EasyAssignMissingCheck.refreshPending then
+        return
+    end
+
+    EasyAssignMissingCheck.refreshPending = true
+
+    local function run()
+        EasyAssignMissingCheck.refreshPending = false
+
+        if EasyAssignMissingCheck.IsShown() then
+            EasyAssignMissingCheck.Populate(EasyAssignMissingCheck.Compute())
+        end
+    end
+
+    if C_Timer and C_Timer.After then
+        C_Timer.After(0.5, run)
+    else
+        run()
+    end
+end
+
+
+-- ============================================================================================
+-- [PLAN B] SNAPSHOT SYNC -- officer pushes their ENTIRE assignment set to the raid as a string over
+-- the addon channel; receivers rebuild it via the proven Backup/Share import path with whole-sheet
+-- OVERWRITE. This deliberately reuses the copy-paste serialize->deserialize path, so:
+--   * the per-client profile field-identity problem disappears (the receiver adopts the SENDER's
+--     profiles AND values as one matched set -- ids line up because they are all the sender's), and
+--   * it uses its own simple paced chunk transport, so it never touches the live-sync/outgoingShare
+--     pipeline (and therefore is immune to the share-once latch).
+-- Trigger:  /ea push   (raid leader or assistant only).
+-- ============================================================================================
+EasyAssignSnapshot = EasyAssignSnapshot or {}
+EasyAssignSnapshot.incoming = EasyAssignSnapshot.incoming or {}
+EasyAssignSnapshot.outgoing = EasyAssignSnapshot.outgoing or {}
+
+-- Sender: resend a specific list of parts (comma-separated seq numbers) to a requester.
+function EasyAssignSnapshot.ResendChunks(id, seqListText, target)
+    local out = EasyAssignSnapshot.outgoing[id]
+    if type(out) ~= "table" or type(out.chunks) ~= "table" then return end
+    local channel = out.channel or "RAID"
+    local dest = out.target
+    for seqText in string.gmatch(tostring(seqListText or ""), "(%d+)") do
+        local seq = tonumber(seqText)
+        if seq and out.chunks[seq] then
+            EasyAssignSendAddonMessage(string.format("SNAP:%s:%d:%d:%s", id, seq, out.total, out.chunks[seq]), channel, dest)
+        end
+    end
+end
+EasyAssignSnapshot.DISABLE_LEGACY_LIVE_SYNC = true
+EasyAssignSnapshot.CHUNK_SIZE = 210
+EasyAssignSnapshot.SEND_INTERVAL = 0.25
+
+function EasyAssignSnapshot.CanPush()
+    if type(IsCurrentPlayerRaidAssignmentOfficer) == "function" then
+        return IsCurrentPlayerRaidAssignmentOfficer()
+    end
+    return true
+end
+
+-- Build a snapshot of the CURRENT raid (active profile + that raid's assignment values). Returns the
+-- snapshot table, or nil if there is no raid selected / nothing to save. Shared by push, whisper
+-- response, and the local "saved setups" feature so all three produce an identical, apply-ready shape.
+function EasyAssignSnapshot.BuildCurrentRaidSnapshot()
+    local selectedRaid = type(GetSelectedRaid) == "function" and GetSelectedRaid() or nil
+    if type(selectedRaid) ~= "table" or type(selectedRaid.id) ~= "string" then
+        return nil
+    end
+    local raidId = selectedRaid.id
+
+    local profile = type(GetActiveAssignmentProfileForRaid) == "function"
+        and GetActiveAssignmentProfileForRaid(raidId) or nil
+    local profileId = (type(profile) == "table" and profile.id)
+        or (type(GetStoredActiveAssignmentProfileIdForRaid) == "function" and GetStoredActiveAssignmentProfileIdForRaid(raidId))
+        or nil
+
+    local raidAssignments = (type(EasyAssignDB) == "table" and type(EasyAssignDB.assignments) == "table")
+        and EasyAssignDB.assignments[raidId] or nil
+
+    local snapshot = {
+        v = 1,
+        raidId = raidId,
+        raidName = selectedRaid.name,
+        profileId = profileId,
+        profile = (type(profile) == "table") and EasyAssignDeepCopyValue(profile) or nil,
+        assignments = (raidAssignments ~= nil) and EasyAssignDeepCopyValue(raidAssignments) or nil,
+    }
+    if snapshot.profile == nil and snapshot.assignments == nil then
+        return nil
+    end
+    return snapshot
+end
+
+-- ---- Saved Setups: named, locally-stored raid setups (personal; not shared) --------------------
+function EasyAssignSnapshot.GetSavedSetupsStore(createIfMissing)
+    if type(EasyAssignDB) ~= "table" then return nil end
+    if createIfMissing and type(EasyAssignDB.savedSetups) ~= "table" then
+        EasyAssignDB.savedSetups = {}
+    end
+    return type(EasyAssignDB.savedSetups) == "table" and EasyAssignDB.savedSetups or nil
+end
+
+function EasyAssignSnapshot.GetSavedSetupNames()
+    local store = EasyAssignSnapshot.GetSavedSetupsStore(false)
+    local names = {}
+    if type(store) == "table" then
+        for name in pairs(store) do names[#names + 1] = name end
+        table.sort(names, function(a, b) return string.lower(a) < string.lower(b) end)
+    end
+    return names
+end
+
+function EasyAssignSnapshot.SaveSetup(name)
+    if not EasyAssignSnapshot.CanPush() then
+        print("|cff66ccffEasy Assign|r Only the raid leader or an assistant can save setups.")
+        return false
+    end
+    name = type(name) == "string" and string.gsub(name, "^%s*(.-)%s*$", "%1") or ""
+    if name == "" then
+        print("|cff66ccffEasy Assign|r Enter a name for the setup.")
+        return false
+    end
+    local snapshot = EasyAssignSnapshot.BuildCurrentRaidSnapshot()
+    if type(snapshot) ~= "table" then
+        print("|cff66ccffEasy Assign|r Nothing to save for this raid yet.")
+        return false
+    end
+    local store = EasyAssignSnapshot.GetSavedSetupsStore(true)
+    if type(store) ~= "table" then return false end
+    store[name] = {
+        snapshot = snapshot,
+        raidName = snapshot.raidName,
+        savedAt = (time and time()) or 0,
+    }
+    print(string.format("|cff66ccffEasy Assign|r Saved setup: %s (%s)", name, tostring(snapshot.raidName or "raid")))
+    if type(EasyAssignRefreshSavedSetupControls) == "function" then EasyAssignRefreshSavedSetupControls() end
+    return true
+end
+
+function EasyAssignSnapshot.LoadSetup(name)
+    if not EasyAssignSnapshot.CanPush() then
+        print("|cff66ccffEasy Assign|r Only the raid leader or an assistant can load setups.")
+        return false
+    end
+    local store = EasyAssignSnapshot.GetSavedSetupsStore(false)
+    local entry = type(store) == "table" and store[name] or nil
+    if type(entry) ~= "table" or type(entry.snapshot) ~= "table" then
+        print("|cff66ccffEasy Assign|r That setup could not be found.")
+        return false
+    end
+    local ok = EasyAssignSnapshot.ApplyData(EasyAssignDeepCopyValue(entry.snapshot), "saved setup")
+    if ok then
+        print(string.format("|cff66ccffEasy Assign|r Loaded setup: %s", tostring(name)))
+        if type(RefreshAssignments) == "function" then RefreshAssignments() end
+        if type(EasyAssignQueueUiRefresh) == "function" then
+            EasyAssignQueueUiRefresh("assignments", "saved-setup-load")
+        end
+    end
+    return ok
+end
+
+function EasyAssignSnapshot.DeleteSetup(name)
+    local store = EasyAssignSnapshot.GetSavedSetupsStore(false)
+    if type(store) == "table" and store[name] ~= nil then
+        store[name] = nil
+        print(string.format("|cff66ccffEasy Assign|r Deleted setup: %s", tostring(name)))
+        if type(EasyAssignRefreshSavedSetupControls) == "function" then EasyAssignRefreshSavedSetupControls() end
+    end
+end
+
+-- Name prompt + confirm dialogs for the saved-setups feature (front-end, no command typing).
+if type(StaticPopupDialogs) == "table" then
+    StaticPopupDialogs["EASYASSIGN_SAVE_SETUP"] = {
+        text = "Name this setup:",
+        button1 = "Save",
+        button2 = "Cancel",
+        hasEditBox = true,
+        maxLetters = 40,
+        OnShow = function(self)
+            local box = self.editBox or (self.GetEditBox and self:GetEditBox())
+            if box then box:SetText(""); box:SetFocus() end
+        end,
+        OnAccept = function(self)
+            local box = self.editBox or (self.GetEditBox and self:GetEditBox())
+            local name = box and box:GetText() or ""
+            if EasyAssignSnapshot and EasyAssignSnapshot.SaveSetup then EasyAssignSnapshot.SaveSetup(name) end
+        end,
+        EditBoxOnEnterPressed = function(self)
+            local parent = self:GetParent()
+            local name = self:GetText()
+            if EasyAssignSnapshot and EasyAssignSnapshot.SaveSetup then EasyAssignSnapshot.SaveSetup(name) end
+            if parent and parent.Hide then parent:Hide() end
+        end,
+        EditBoxOnEscapePressed = function(self) local pr = self:GetParent(); if pr and pr.Hide then pr:Hide() end end,
+        timeout = 0, whileDead = true, hideOnEscape = true, preferredIndex = 3,
+    }
+    StaticPopupDialogs["EASYASSIGN_LOAD_SETUP_CONFIRM"] = {
+        text = "Load setup \"%s\"? This replaces the current assignments for its raid.",
+        button1 = "Load",
+        button2 = "Cancel",
+        OnAccept = function(self, data)
+            if EasyAssignSnapshot and EasyAssignSnapshot.LoadSetup then EasyAssignSnapshot.LoadSetup(data) end
+        end,
+        timeout = 0, whileDead = true, hideOnEscape = true, preferredIndex = 3,
+    }
+    StaticPopupDialogs["EASYASSIGN_DELETE_SETUP_CONFIRM"] = {
+        text = "Delete saved setup \"%s\"?",
+        button1 = "Delete",
+        button2 = "Cancel",
+        OnAccept = function(self, data)
+            if EasyAssignSnapshot and EasyAssignSnapshot.DeleteSetup then EasyAssignSnapshot.DeleteSetup(data) end
+        end,
+        timeout = 0, whileDead = true, hideOnEscape = true, preferredIndex = 3,
+    }
+end
+
+-- Open the Load/Delete menu via the addon's own dropdown menu system (consistent look, always present).
+function EasyAssignOpenSavedSetupMenu(anchorFrame, mode)
+    if type(OpenAssignmentDropdownMenu) ~= "function" then return end
+    local names = (EasyAssignSnapshot and EasyAssignSnapshot.GetSavedSetupNames and EasyAssignSnapshot.GetSavedSetupNames()) or {}
+    local menu = {}
+    local deleting = (mode == "delete")
+
+    menu[#menu + 1] = { text = deleting and "Delete which setup?" or "Load a saved setup", isTitle = true, notCheckable = true }
+
+    if #names == 0 then
+        menu[#menu + 1] = { text = "(no saved setups yet)", disabled = true, notCheckable = true }
+    else
+        for _, name in ipairs(names) do
+            local thisName = name
+            menu[#menu + 1] = {
+                text = thisName,
+                notCheckable = true,
+                func = function()
+                    CloseDropDownMenus()
+                    if type(StaticPopup_Show) == "function" then
+                        StaticPopup_Show(deleting and "EASYASSIGN_DELETE_SETUP_CONFIRM" or "EASYASSIGN_LOAD_SETUP_CONFIRM", thisName, nil, thisName)
+                    end
+                end,
+            }
+        end
+        if deleting then
+            menu[#menu + 1] = { text = "Back to load", notCheckable = true, func = function() EasyAssignOpenSavedSetupMenu(anchorFrame, "load") end }
+        else
+            menu[#menu + 1] = { text = "Delete a setup...", notCheckable = true, func = function() EasyAssignOpenSavedSetupMenu(anchorFrame, "delete") end }
+        end
+    end
+
+    OpenAssignmentDropdownMenu(menu, anchorFrame)
+end
+
+-- Core: build the current-raid snapshot and transmit it over (destChannel, destTarget). Used both for
+-- the manual raid-wide push and for a targeted whisper response to a catch-up request.
+function EasyAssignSnapshot.Transmit(destChannel, destTarget, isResponse)
+    if type(EasyAssignBackupShare) ~= "table" or type(EasyAssignBackupShare.EncodeBody) ~= "function" then
+        return false
+    end
+
+    local snapshot = EasyAssignSnapshot.BuildCurrentRaidSnapshot()
+    if type(snapshot) ~= "table" then
+        if not isResponse then print("|cff66ccffEasy Assign|r Nothing to push for this raid yet (select a raid with assignments).") end
+        return false
+    end
+    if type(EasyAssignEncodeJsonValue) ~= "function" then
+        if not isResponse then print("|cff66ccffEasy Assign|r Serializer unavailable.") end
+        return false
+    end
+
+    local rawText = EasyAssignEncodeJsonValue(snapshot)
+    local body, flag = EasyAssignBackupShare.EncodeBody(rawText)
+    local encoded = tostring(flag) .. body
+    local playerName = (type(GetShortPlayerName) == "function"
+        and GetShortPlayerName(UnitName and UnitName("player") or "player")) or "player"
+    local id = string.gsub(string.format("%s-%d-%d", playerName, (time and time() or 0), math.random(1000, 9999)), ":", "-")
+    local total = math.max(math.ceil(#encoded / EasyAssignSnapshot.CHUNK_SIZE), 1)
+
+    local chunks = {}
+    for seq = 1, total do
+        local startIndex = ((seq - 1) * EasyAssignSnapshot.CHUNK_SIZE) + 1
+        chunks[seq] = string.sub(encoded, startIndex, startIndex + EasyAssignSnapshot.CHUNK_SIZE - 1)
+    end
+
+    EasyAssignSnapshot.outgoing[id] = { chunks = chunks, total = total, channel = destChannel, target = destTarget, startedAt = (GetTime and GetTime()) or 0 }
+
+    local index = 0
+    local function sendNext()
+        index = index + 1
+        if index > total then
+            return
+        end
+        EasyAssignSendAddonMessage(string.format("SNAP:%s:%d:%d:%s", id, index, total, chunks[index]), destChannel, destTarget)
+        if index < total then
+            if C_Timer and C_Timer.After then
+                C_Timer.After(EasyAssignSnapshot.SEND_INTERVAL, sendNext)
+            else
+                sendNext()
+            end
+        end
+    end
+    sendNext()
+
+    if not isResponse and IsEasyAssignSyncMessagesEnabled() then
+        print("|cff66ccffEasy Assign|r Sharing assignments with the raid...")
+    end
+    return true
+end
+
+function EasyAssignSnapshot.Send()
+    if not EasyAssignSnapshot.CanPush() then
+        print("|cff66ccffEasy Assign|r Only the raid leader or an assistant can push assignments.")
+        return
+    end
+
+    local channel = type(GetEasyAssignCommChannel) == "function" and GetEasyAssignCommChannel() or nil
+    if not channel then
+        print("|cff66ccffEasy Assign|r Join a raid or party before pushing assignments.")
+        return
+    end
+
+    local pushed = EasyAssignSnapshot.Transmit(channel, nil, false)
+
+    -- Safety net: warn the officer if anyone they just shared assignments to is not in the raid.
+    if type(EasyAssignMissingCheck) == "table" and type(EasyAssignMissingCheck.OnPush) == "function" then
+        EasyAssignMissingCheck.OnPush()
+    end
+
+    -- The pusher's own client filters out its own broadcasts (HandleEasyAssignAddonMessage self-skip:
+    -- senderName == playerName -> return), so the receive-side auto-open never fires for the person who
+    -- pushed. Pop their personal window here too so an officer can review their own assignments right after
+    -- pushing. Self-gated by EasyAssignMaybeAutoOpenMyAssignmentsPopup: it no-ops unless auto-open is
+    -- enabled AND the pusher actually has assignments, honours "current raid only", never steals focus from
+    -- an already-open window, and defers past combat. Only fires on an explicit manual push -- the scoped
+    -- auto-sync from editing does NOT route through here, so the window won't pop on every edit.
+    if pushed and type(EasyAssignMaybeAutoOpenMyAssignmentsPopup) == "function" then
+        local raid = type(GetSelectedRaid) == "function" and GetSelectedRaid() or nil
+        local raidId = type(raid) == "table" and type(raid.id) == "string" and raid.id or nil
+        EasyAssignMaybeAutoOpenMyAssignmentsPopup(raidId, nil)
+    end
+end
+
+-- Targeted response to a catch-up request: whisper the current snapshot to one player, quietly.
+function EasyAssignSnapshot.SendTo(target)
+    if type(target) ~= "string" or target == "" then
+        return
+    end
+    EasyAssignSnapshot.Transmit("WHISPER", target, true)
+end
+
+-- Late-joiner catch-up REQUEST: ask officers for the current assignments. Debounced so frequent roster
+-- churn never spams the raid. Anyone may request; only the raid leader answers (see OnCatchupRequest).
+function EasyAssignSnapshot.RequestCatchup()
+    if not (IsInRaid and IsInRaid()) then
+        return
+    end
+    local channel = type(GetEasyAssignCommChannel) == "function" and GetEasyAssignCommChannel() or nil
+    if not channel then
+        return
+    end
+    local now = (GetTime and GetTime()) or 0
+    if EasyAssignSnapshot.lastCatchupRequest and (now - EasyAssignSnapshot.lastCatchupRequest) < 15 then
+        return
+    end
+    EasyAssignSnapshot.lastCatchupRequest = now
+    EasyAssignSendAddonMessage("SNAPGET", channel)
+end
+
+-- Leader-side handler for a catch-up request: the raid leader whispers the current snapshot back to the
+-- requester. Leader-only keeps it a single authoritative answer with no duplicate whispers. Debounced
+-- per requester so a reconnect storm can't trigger repeated sends to the same player.
+function EasyAssignSnapshot.OnCatchupRequest(requester)
+    if type(requester) ~= "string" or requester == "" then
+        return
+    end
+    if not (IsInRaid and IsInRaid()) then
+        return
+    end
+    if not (IsCurrentPlayerRaidLeader and IsCurrentPlayerRaidLeader()) then
+        return
+    end
+
+    EasyAssignSnapshot.servedRecently = EasyAssignSnapshot.servedRecently or {}
+    local now = (GetTime and GetTime()) or 0
+    if EasyAssignSnapshot.servedRecently[requester] and (now - EasyAssignSnapshot.servedRecently[requester]) < 10 then
+        return
+    end
+    EasyAssignSnapshot.servedRecently[requester] = now
+
+    if C_Timer and C_Timer.After then
+        C_Timer.After(0.5, function() EasyAssignSnapshot.SendTo(requester) end)
+    else
+        EasyAssignSnapshot.SendTo(requester)
+    end
+end
+
+
+local function EASnapMsg(text)
+    if type(print) == "function" then print("|cff66ccffEA-Snapshot|r " .. tostring(text)) end
+end
+
+-- Merge a current-raid snapshot into this client: install the sender's active profile, make it active
+-- for that raid, and replace that raid's assignment values. Other raids/profiles are left untouched.
+function EasyAssignSnapshot.ApplyData(data, sender)
+    if type(data) ~= "table" or type(data.raidId) ~= "string" or data.raidId == "" then
+        return false, "bad snapshot"
+    end
+    if type(EasyAssignDB) ~= "table" then
+        return false, "addon not ready"
+    end
+
+    EasyAssignDB.assignmentProfiles = EasyAssignDB.assignmentProfiles or {}
+    EasyAssignDB.activeAssignmentProfileIdsByRaid = EasyAssignDB.activeAssignmentProfileIdsByRaid or {}
+    EasyAssignDB.assignments = EasyAssignDB.assignments or {}
+
+    if type(data.profile) == "table" and type(data.profileId) == "string" and data.profileId ~= "" then
+        local prof = EasyAssignDeepCopyValue(data.profile)
+        prof.id = data.profileId
+        prof.raidId = data.raidId
+        EasyAssignDB.assignmentProfiles[data.profileId] = prof
+        EasyAssignDB.activeAssignmentProfileIdsByRaid[data.raidId] = data.profileId
+    end
+
+    if data.assignments ~= nil then
+        EasyAssignDB.assignments[data.raidId] = EasyAssignDeepCopyValue(data.assignments)
+    end
+
+    -- Invalidate the assignment caches so the My Assignments window (and its auto-open check) rebuild
+    -- against the freshly-applied data. Without this, a receiver who had a cached "no assignments"
+    -- result keeps it, and their personal window never auto-opens even though they now have one.
+    if type(EasyAssignBumpAssignmentProfileRevision) == "function" then
+        EasyAssignBumpAssignmentProfileRevision("snapshot-apply")
+    end
+    if type(EasyAssignBumpAssignmentDataRevision) == "function" then
+        EasyAssignBumpAssignmentDataRevision("snapshot-apply")
+    end
+    state.myAssignmentsCache = {}
+
+    return true
+end
+
+function EasyAssignSnapshot.OnChunk(id, seq, total, data, sender)
+    if type(id) ~= "string" or id == "" then return end
+    if type(seq) ~= "number" or type(total) ~= "number" or total < 1 then return end
+    if type(data) ~= "string" then return end
+
+    local entry = EasyAssignSnapshot.incoming[id]
+    if not entry then
+        entry = { chunks = {}, total = total, received = 0, sender = sender, startedAt = (GetTime and GetTime()) or 0 }
+        EasyAssignSnapshot.incoming[id] = entry
+    end
+
+    if not entry.chunks[seq] then
+        entry.chunks[seq] = data
+        entry.received = entry.received + 1
+    end
+
+    if entry.received < entry.total then
+        -- Schedule a one-shot check: if still missing parts shortly after activity settles, ask the
+        -- sender to resend just the gaps. Guarantees completion even when the throttle drops chunks.
+        if C_Timer and C_Timer.After and not entry.recoveryQueued then
+            entry.recoveryQueued = true
+            C_Timer.After(1.5, function()
+                local e = EasyAssignSnapshot.incoming[id]
+                if type(e) ~= "table" then return end
+                e.recoveryQueued = false
+                if e.received >= e.total then return end
+                local missing = {}
+                for i = 1, e.total do
+                    if type(e.chunks[i]) ~= "string" then
+                        missing[#missing + 1] = tostring(i)
+                    end
+                end
+                if #missing > 0 and e.sender and e.sender ~= "" then
+                    EasyAssignSendAddonMessage(string.format("SNAPREQ:%s:%s", id, table.concat(missing, ",")), "WHISPER", e.sender)
+                end
+            end)
+        end
+        return
+    end
+
+    local parts = {}
+    for i = 1, entry.total do
+        if type(entry.chunks[i]) ~= "string" then
+            EASnapMsg(string.format("Still waiting on part %d of %d...", i, entry.total))
+            return
+        end
+        parts[i] = entry.chunks[i]
+    end
+    EasyAssignSnapshot.incoming[id] = nil
+
+    local full = table.concat(parts)
+
+    if type(EasyAssignBackupShare) ~= "table" or type(EasyAssignBackupShare.Decode) ~= "function"
+        or type(EasyAssignBackupShare.Apply) ~= "function" then
+        print("|cff66ccffEasy Assign|r Snapshot module unavailable.")
+        return
+    end
+
+    local flag = string.sub(full, 1, 1)
+    local body = string.sub(full, 2)
+    local rawText, decodeErr = EasyAssignBackupShare.DecodeBody(body, flag)
+    if type(rawText) ~= "string" then
+        print("|cff66ccffEasy Assign|r Could not read received assignments.")
+        return
+    end
+    if type(DecodeJson) ~= "function" then
+        print("|cff66ccffEasy Assign|r Decoder unavailable.")
+        return
+    end
+    local snapshot, jsonErr = DecodeJson(rawText)
+    if type(snapshot) ~= "table" then
+        print("|cff66ccffEasy Assign|r Received assignments were unreadable.")
+        return
+    end
+
+    local ok, applyMsg = EasyAssignSnapshot.ApplyData(snapshot, entry.sender)
+    if ok then
+        if IsEasyAssignSyncMessagesEnabled() then
+            print(string.format("|cff66ccffEasy Assign|r Received assignments from %s.", tostring(entry.sender or "?")))
+        end
+        if type(RefreshAssignments) == "function" then RefreshAssignments() end
+        if type(EasyAssignQueueUiRefresh) == "function" then
+            EasyAssignQueueUiRefresh("assignments", "snapshot-import")
+            EasyAssignQueueUiRefresh("myAssignmentsPage", "snapshot-import")
+            EasyAssignQueueUiRefresh("myAssignmentsPopup", "snapshot-import")
+            EasyAssignQueueUiRefresh("raidLeaderWindow", "snapshot-import")
+        end
+        -- Pop the personal "My Assignments" window for anyone who now has assignments (respects the
+        -- user's auto-open setting and defers past combat -- reuses the existing push auto-open logic).
+        if type(EasyAssignMaybeAutoOpenMyAssignmentsPopup) == "function" then
+            EasyAssignMaybeAutoOpenMyAssignmentsPopup(snapshot.raidId, nil)
+        end
+    else
+        print("|cff66ccffEasy Assign|r Could not apply received assignments: " .. tostring(applyMsg or "unknown"))
+    end
+end
+
+-- Drop stale partial snapshots that never completed (e.g. a dropped chunk).
+if C_Timer and C_Timer.NewTicker then
+    C_Timer.NewTicker(30, function()
+        local now = (GetTime and GetTime()) or 0
+        for id, entry in pairs(EasyAssignSnapshot.incoming) do
+            if type(entry) == "table" and (now - (entry.startedAt or 0)) > 30 then
+                EasyAssignSnapshot.incoming[id] = nil
+            end
+        end
+        for id, entry in pairs(EasyAssignSnapshot.outgoing) do
+            if type(entry) == "table" and (now - (entry.startedAt or 0)) > 60 then
+                EasyAssignSnapshot.outgoing[id] = nil
+            end
+        end
+    end)
+end
