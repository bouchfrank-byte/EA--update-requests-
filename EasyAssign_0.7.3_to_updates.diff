+-- === Window minimize (collapse to title bar; state persists across /reload + relog) =========
+-- Both floating windows share the same skeleton (title top-left, close button top-right), so
+-- minimize is implemented identically for each: hide every child below the title strip, shrink
+-- the frame to a header-only height, and swap the button glyph. The real (expanded) size is
+-- preserved in settings the whole time -- see the minimized-aware Save*Anchor functions above,
+-- which keep the stored width/height instead of reading the collapsed height off the frame.
+EASY_ASSIGN_MINIMIZED_HEADER_HEIGHT = 38
+
+function ApplyMyAssignmentsPopupMinimizedState()
+    local frame = myAssignmentsPopupFrame
+
+    if not frame then
+        return
+    end
+
+    local isMinimized = IsMyAssignmentsPopupMinimized()
+    local childKeys = { "counterText", "raidDropdown", "bossDropdown", "bodyPanel", "previousButton", "nextButton" }
+
+    for _, key in ipairs(childKeys) do
+        local child = frame[key]
+        if child then
+            if isMinimized then
+                child:Hide()
+            else
+                child:Show()
+            end
+        end
+    end
+
+    -- Parity with the raid window: the personal window can hide its title via the header
+    -- toggle, so keep the title shown while collapsed to guarantee a draggable grab strip.
+    if frame.title and isMinimized then
+        frame.title:Show()
+    end
+
+    if frame.resizeHandle then
+        if isMinimized then
+            frame.resizeHandle:Hide()
+        else
+            frame.resizeHandle:SetShown(not IsMyAssignmentsPopupLockedInPlace())
+        end
+    end
+
+    if frame.minimizeButton then
+        if isMinimized then
+            frame.minimizeButton:SetNormalTexture("Interface\\Buttons\\UI-Panel-ExpandButton-Up")
+            frame.minimizeButton:SetPushedTexture("Interface\\Buttons\\UI-Panel-ExpandButton-Down")
+            frame.minimizeButton.tooltipText = "Restore"
+        else
+            frame.minimizeButton:SetNormalTexture("Interface\\Buttons\\UI-Panel-CollapseButton-Up")
+            frame.minimizeButton:SetPushedTexture("Interface\\Buttons\\UI-Panel-CollapseButton-Down")
+            frame.minimizeButton.tooltipText = "Minimize"
+        end
+    end
+
+    if isMinimized then
+        frame:SetHeight(EASY_ASSIGN_MINIMIZED_HEADER_HEIGHT)
