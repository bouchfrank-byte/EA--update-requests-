+-- Blizzard-style right-click menu for a roster member on the Home frame. Uses the addon's
+-- standard UIDropDownMenu so it is reliable across the 2.5.6 UI; actions are permission-gated.
+function EasyAssignShowRosterUnitMenu(unit, name)
+    if type(name) ~= "string" or name == "" then
+        return false
+    end
+
+    if type(UIDropDownMenu_Initialize) ~= "function" or type(ToggleDropDownMenu) ~= "function"
+        or type(UIDropDownMenu_CreateInfo) ~= "function" or type(UIDropDownMenu_AddButton) ~= "function" then
+        return false
+    end
+
+    if not EasyAssignRosterUnitMenuFrame then
+        EasyAssignRosterUnitMenuFrame = CreateFrame("Frame", "EasyAssignRosterUnitMenu", UIParent, "UIDropDownMenuTemplate")
+    end
+
+    local frame = EasyAssignRosterUnitMenuFrame
+
+    -- Right-click toggles our menu: a second right-click on the SAME member closes it instead of
+    -- re-opening. A different member (or an already-closed menu) opens fresh.
+    local menuKey = (unit or "") .. "\30" .. name
+    local listShown = DropDownList1 and DropDownList1.IsShown and DropDownList1:IsShown()
+
+    if listShown and UIDROPDOWNMENU_OPEN_MENU == frame and frame.easyAssignMenuKey == menuKey then
+        if type(HideDropDownMenu) == "function" then
+            HideDropDownMenu(1)
+        end
+        frame.easyAssignMenuKey = nil
+        return true
+    end
+
+    frame.easyAssignMenuKey = menuKey
+
+    if type(HideDropDownMenu) == "function" then
+        HideDropDownMenu(1)
+    end
+
+    UIDropDownMenu_Initialize(frame, function(_, level, menuList)
+        local entries
+
+        if (level or 1) == 1 then
+            entries = EasyAssignBuildRosterUnitMenu(unit, name)
+        else
+            entries = menuList
+        end
+
+        if type(entries) ~= "table" then
+            return
+        end
+
+        for _, entry in ipairs(entries) do
+            local info = UIDropDownMenu_CreateInfo()
+
+            info.text = entry.text
+            info.isTitle = entry.isTitle
+            info.notCheckable = entry.notCheckable ~= false
+            info.disabled = entry.disabled
+            info.func = entry.func
+            info.hasArrow = entry.hasArrow
+            info.menuList = entry.menuList
+            info.keepShownOnClick = false
+
+            UIDropDownMenu_AddButton(info, level)
+        end
+    end, "MENU")
+
+    ToggleDropDownMenu(1, nil, frame, "cursor", 0, 0)
+
+    return true
+end
