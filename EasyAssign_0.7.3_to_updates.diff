+-- Export the currently-selected scope into the box, auto-selected for Ctrl+C.
+function EasyAssignBackupShare.DoExport()
+    EasyAssignBackupShare.Disarm()
+    EasyAssignBackupShare.SetBanner("")
+    if type(state) == "table" then
+        state.backupSharePendingPayload = nil
+    end
+
+    local scope = type(state) == "table" and state.backupShareScope or nil
+    if type(scope) ~= "table" or type(scope.kind) ~= "string" then
+        EasyAssignBackupShare.SetStatus("Choose what to back up from the dropdown first.", true)
+        return
+    end
+
+    local payload, buildError = EasyAssignBackupShare.BuildPayload(scope)
+    if not payload then
+        EasyAssignBackupShare.SetStatus(buildError or "Nothing to export for that choice.", true)
+        return
+    end
+
+    local str, encodeError = EasyAssignBackupShare.Encode(payload)
+    if not str then
+        EasyAssignBackupShare.SetStatus(encodeError or "Could not build the export string.", true)
+        return
+    end
+
+    if type(state) == "table" then
+        state.backupShareMode = "export"
+    end
+    EasyAssignBackupShare.SetBoxText(str, true)
+    EasyAssignBackupShare.SelectBoxText()
+
+    local desc = EasyAssignBackupShare.Describe(payload)
+    EasyAssignBackupShare.SetBanner(desc.title .. (desc.detail ~= "" and ("  -  " .. desc.detail) or ""))
+    EasyAssignBackupShare.SetStatus(string.format("Ready to copy (%d characters). Press Ctrl+C.", #str), false)
+end
