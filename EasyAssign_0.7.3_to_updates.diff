+function EasyAssignComputeRaidAssignmentSignature(raidId)
+    local acc = { count = 0, hash = 0 }
+
+    -- Hash the direct, context-free store (EasyAssignDB.assignments[raidId]) — the same table the
+    -- pull writes to and My Assignments reads. The preset/selected-raid-aware getters diverge
+    -- between leader and receiver, so they can't be used for a cross-client fingerprint. General
+    -- assignments live in a separate, selected-raid-dependent store and are intentionally left out;
