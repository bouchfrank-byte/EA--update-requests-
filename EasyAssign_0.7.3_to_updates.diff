+function EasyAssignBackupShare.SetBoxText(text, readOnly)
+    local editBox = mainFrame and mainFrame.backupShareEditBox
+    if not editBox then
+        return
+    end
+    editBox.easyAssignReadOnly = readOnly and true or false
+    editBox.easyAssignStaticText = readOnly and (text or "") or nil
+    editBox.easyAssignUpdating = true
+    editBox:SetText(text or "")
+    editBox:SetCursorPosition(0)
+    editBox.easyAssignUpdating = false
+
+    local function relayout()
+        local box = mainFrame and mainFrame.backupShareEditBox
+        local scroll = mainFrame and mainFrame.backupShareScrollFrame
+        if not box then
+            return
+        end
+        -- Force the box to span the scroll-frame width. Guards against a stale/zero width (from an
+        -- OnSizeChanged that fired while the popup was still laying out) that would wrap the text
+        -- into an invisible one-pixel sliver.
+        if scroll and scroll.GetWidth then
+            local width = scroll:GetWidth() or 0
+            if width > 8 then
+                box:SetWidth(width - 8)
+            end
+        end
+        if type(EasyAssignAssignmentProfileImportExport) == "table"
+            and type(EasyAssignAssignmentProfileImportExport.UpdateTransferEditBoxLayout) == "function" then
+            EasyAssignAssignmentProfileImportExport.UpdateTransferEditBoxLayout(box)
+        end
+        if scroll then
+            scroll:SetVerticalScroll(0)
+        end
+    end
+
+    relayout()
+    -- Re-run once the popup/scroll-frame sizes have settled. On first open the layout can lag a
+    -- frame, leaving the multiline edit box at its creation height of 1 (text clipped to a sliver,
+    -- so the box looks empty even though SetText succeeded).
+    if type(C_Timer) == "table" and type(C_Timer.After) == "function" then
+        C_Timer.After(0, relayout)
+    end
+end
+
+function EasyAssignBackupShare.SelectBoxText()
+    local editBox = mainFrame and mainFrame.backupShareEditBox
+    if editBox then
+        editBox:SetFocus()
+        if editBox.HighlightText then
+            editBox:HighlightText()
+        end
+        editBox:SetCursorPosition(0)
+    end
+end
