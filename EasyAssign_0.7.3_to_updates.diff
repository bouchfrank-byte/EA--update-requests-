+-- Read the pasted string and self-identify it (does not import yet).
+function EasyAssignBackupShare.DoIdentify()
+    EasyAssignBackupShare.Disarm()
+    local editBox = mainFrame and mainFrame.backupShareEditBox
+    local text = editBox and editBox:GetText() or ""
+
+    if type(state) == "table" then
+        state.backupShareMode = "import"
+    end
+    -- Make sure the box is editable again if a prior export left it read-only.
+    if editBox then
+        editBox.easyAssignReadOnly = false
+        editBox.easyAssignStaticText = nil
+    end
+
+    local payload, decodeError = EasyAssignBackupShare.Decode(text)
+    if not payload then
+        if type(state) == "table" then
+            state.backupSharePendingPayload = nil
+        end
+        EasyAssignBackupShare.SetBanner("")
+        EasyAssignBackupShare.SetStatus(decodeError or "Could not read that string.", true)
+        return
+    end
+
+    if type(state) == "table" then
+        state.backupSharePendingPayload = payload
+    end
+
+    local desc = EasyAssignBackupShare.Describe(payload)
+    EasyAssignBackupShare.SetBanner(desc.title .. (desc.detail ~= "" and ("  -  " .. desc.detail) or ""))
+    EasyAssignBackupShare.SetStatus('Recognized. Choose "Import as copy" (safe) or "Overwrite" to replace.', false)
+end
+
+-- Import the recognized payload. mode = "copy" | "overwrite".
+function EasyAssignBackupShare.DoImport(mode)
+    local payload = type(state) == "table" and state.backupSharePendingPayload or nil
+
+    if type(payload) ~= "table" then
+        -- Try to identify from the box first so a single click can work.
+        EasyAssignBackupShare.DoIdentify()
+        payload = type(state) == "table" and state.backupSharePendingPayload or nil
+        if type(payload) ~= "table" then
+            return
+        end
+    end
+
+    if mode == "overwrite" then
+        -- Two-click arm/confirm so we never silently clobber.
+        if not (type(state) == "table" and state.backupShareOverwriteArmed) then
+            if type(state) == "table" then
+                state.backupShareOverwriteArmed = true
+            end
+            if mainFrame and mainFrame.backupShareOverwriteButton and mainFrame.backupShareOverwriteButton.text then
+                mainFrame.backupShareOverwriteButton.text:SetText("Confirm?")
+            end
+            EasyAssignBackupShare.SetStatus("Overwrite will replace existing data. Click Overwrite again to confirm.", true)
+            return
+        end
+    end
+
+    local ok, message = EasyAssignBackupShare.Apply(payload, mode)
+    EasyAssignBackupShare.Disarm()
+    EasyAssignBackupShare.SetStatus(message or (ok and "Imported." or "Import failed."), not ok)
+
+    if ok then
+        -- Clear the pending payload so a second click can't double-import unintentionally.
+        if type(state) == "table" then
+            state.backupSharePendingPayload = nil
+        end
+        if type(print) == "function" then
+            print("Easy Assign: " .. (message or "Imported backup."))
+        end
+        -- Step 2: diff imported assignments against the live raid and surface who's missing.
+        if type(EasyAssignMissingCheck) == "table" and type(EasyAssignMissingCheck.OnImport) == "function" then
+            EasyAssignMissingCheck.OnImport(payload)
+        end
+    end
+end
