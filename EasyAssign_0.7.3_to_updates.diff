+-- === Auto-sync: leader nudges receivers to pull, verified by a content signature ===========
+-- The reliable delivery path is the pull (Request Sync). Rather than push heavy data, the leader
+-- broadcasts a tiny SYNCNOW nudge carrying a fingerprint of the assignments; each receiver pulls
+-- (staggered) and re-checks its own fingerprint against the leader's, retrying until they match.
+local function EasyAssignHashString(str)
+    local hash = 5381
+
+    for i = 1, #str do
+        hash = (hash * 33 + string.byte(str, i)) % 2147483647
+    end
+
+    return hash
+end
+
+local function EasyAssignAccumulateSignature(value, keyPath, acc)
+    local vtype = type(value)
+
+    if vtype == "table" then
+        for k, v in pairs(value) do
+            EasyAssignAccumulateSignature(v, keyPath .. "\1" .. tostring(k), acc)
+        end
+    elseif vtype == "string" then
+        if value ~= "" then
+            acc.count = acc.count + 1
+            acc.hash = (acc.hash + EasyAssignHashString(keyPath .. "\2" .. value)) % 2147483647
+        end
+    elseif vtype == "number" or vtype == "boolean" then
+        acc.count = acc.count + 1
+        acc.hash = (acc.hash + EasyAssignHashString(keyPath .. "\2" .. tostring(value))) % 2147483647
+    end
+end
