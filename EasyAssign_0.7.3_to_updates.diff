+function EasyAssignQueueSyncNowBroadcast(delaySeconds)
+    local signature, raidId = EasyAssignGetSyncNowBroadcastSignature()
+    local sequence
+
+    if not signature or not raidId then
+        return false
+    end
+
+    state.syncNowBroadcastSequence = (state.syncNowBroadcastSequence or 0) + 1
+    sequence = state.syncNowBroadcastSequence
+
+    local function SendSyncNowBroadcast()
+        local currentSignature, currentRaidId = EasyAssignGetSyncNowBroadcastSignature()
+
+        if state.syncNowBroadcastSequence ~= sequence then
+            return
+        end
+
+        -- Re-validate at fire time: authority, raid selection, roster and fingerprint may all have
+        -- changed during the debounce window; only send if we still hold the same advertisement.
+        if currentSignature ~= signature or currentRaidId ~= raidId then
+            return
+        end
+
+        EasyAssignBroadcastSyncNow(raidId)
+    end
+
+    if C_Timer and C_Timer.After and (delaySeconds or 0) > 0 then
+        C_Timer.After(delaySeconds, SendSyncNowBroadcast)
+    else
+        SendSyncNowBroadcast()
+    end
+
+    return true
+end
+
+function EasyAssignMaybeBroadcastSyncNowOnRosterChange(delaySeconds)
+    local signature = EasyAssignGetSyncNowBroadcastSignature()
+
+    if not signature then
+        state.lastSyncNowBroadcastSignature = nil
+        state.syncNowBroadcastSequence = (state.syncNowBroadcastSequence or 0) + 1
+        return
+    end
+
+    if state.lastSyncNowBroadcastSignature == signature then
+        return
+    end
+
+    state.lastSyncNowBroadcastSignature = signature
+    EasyAssignQueueSyncNowBroadcast(delaySeconds or 1)
+end
