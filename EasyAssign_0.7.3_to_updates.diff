+function EasyAssignBackupShare.ClearBox()
+    EasyAssignBackupShare.Disarm()
+    if type(state) == "table" then
+        state.backupSharePendingPayload = nil
+        state.backupShareMode = "import"
+    end
+    EasyAssignBackupShare.SetBoxText("", false)
+    EasyAssignBackupShare.SetBanner("")
+    EasyAssignBackupShare.SetStatus("", false)
+    local editBox = mainFrame and mainFrame.backupShareEditBox
+    if editBox then
+        editBox:SetFocus()
+    end
+end
